----
import {
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.8/crypto",
}
----

///|
async fn main {
  guard @env.args()[1:] is [input, output] else {
    fail("usage: generate_mount_case.mbtx WINDOWS_UPPER_TABLE OUTPUT_MBT")
  }
  let source = @fs.read_file(input).binary()
  assert_eq(
    @crypto.bytes_to_hex_string(@crypto.sha256(source)),
    "76a66e29298eafc744fa1e8e11c80c3de28219c70539b3fb10efbccadb6ae335",
  )
  let pairs : Array[(Int32, Int32)] = []
  for line in @utf8.decode(source).split("\n") {
    if !line.has_prefix("0x") {
      continue
    }
    let fields = line.split("\t").to_array()
    let lower = @string.parse_int(fields[0][2:].to_owned(), radix=16)
    let upper = @string.parse_int(fields[1][2:].to_owned(), radix=16)
    pairs.push((lower, upper))
  }
  pairs.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(pairs.length(), 973)
  let data = StringBuilder()
  data.write_string(
    "// Generated by scripts/generate_mount_case.mbtx. See third_party/microsoft/README.md.\n\n///|\n",
  )
  data.write_string(
    "let mount_upper_ranges : FixedArray[(Int32, Int32, Int32, Int32)] = [\n",
  )
  for i = 0; i < pairs.length(); {
    let (first, upper) = pairs[i]
    let mut last = first
    let mut stride = 1
    let mut next = i + 1
    while next < pairs.length() {
      let (lower, mapped) = pairs[next]
      let gap = lower - last
      if gap < 1 ||
        gap > 2 ||
        (last != first && gap != stride) ||
        mapped - upper != lower - first {
        break
      }
      stride = gap
      last = lower
      next += 1
    }
    data.write_string("  (\{first}, \{last}, \{stride}, \{upper}),\n")
    continue next
  }
  data.write_string("]\n")
  @fs.write_file(output, data.to_string())
}
