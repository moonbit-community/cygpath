----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/async@0.22.10/process",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn main {
  guard @env.args()[1:] is [output] else {
    fail("usage: check_consumer.mbtx NEW_OUTPUT_DIRECTORY")
  }
  let repository = @fs.realpath(".").replace_all(old="\\", new="/")
  guard !@fs.exists(output) else { fail("output directory already exists") }
  @fs.mkdir(output)
  let output = @fs.realpath(output).replace_all(old="\\", new="/")
  let consumer = output + "/consumer"
  @fs.mkdir(consumer)
  @fs.write_file(
    output + "/moon.work",
    "members = [\"./consumer\", " + Json(repository).stringify() + "]\n",
  )
  @fs.write_file(
    consumer + "/moon.mod",
    "name = \"cygpath-tests/consumer\"\nimport {\n  \"ZSeanYves/cygpath@0.1.0\",\n}\n",
  )
  @fs.write_file(
    consumer + "/moon.pkg",
    "import {\n  \"ZSeanYves/cygpath/lib\" @cygpath,\n} for \"test\"\n",
  )
  @fs.write_file(
    consumer + "/api_test.mbt",
    @fs.read_file("testdata/contracts/consumer.mbt.txt").binary(),
  )
  @fs.write_file(output + "/empty.bin", b"")
  let args = ["test", ".", "--target", "wasm", "--deny-warn"]
  let code = @async.with_timeout_opt(180000, () => {
    @process.run(
      "moon",
      args,
      cwd=consumer,
      stdin=@process.redirect_from_file(output + "/empty.bin"),
      stdout=@process.redirect_to_file(
        output + "/wasm.stdout.bin",
        create_mode=CreateNew,
      ),
      stderr=@process.redirect_to_file(
        output + "/wasm.stderr.bin",
        create_mode=CreateNew,
      ),
      cancel_handler=@process.hard_cancel(),
    )
  })
  let summary : Json = {
    "validation_kind": "external-public-api-consumer",
    "source": repository,
    "results": [
      {
        "backend": "wasm",
        "command": Json(["moon", ..args]),
        "exit_code": Json(code),
      },
    ],
  }
  @fs.write_file(output + "/summary.json", summary.stringify(indent=2) + "\n")
  guard code == Some(0) else {
    fail("external Wasm consumer failed: " + output)
  }
  println("External Wasm public API consumer passed: " + output)
}
