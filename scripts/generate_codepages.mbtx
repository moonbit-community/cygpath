///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/core/env",
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
}

///|
fn words(line : String) -> Array[String] {
  let text = line.split_once(";").map(pair => pair.0.to_owned()).unwrap_or(line)
  text
  .replace_all(old="\t", new=" ")
  .trim()
  .split(" ")
  .filter(word => !word.is_empty())
  .map(word => word.to_owned())
  .to_array()
}

///|
fn number(text : String) -> Int raise {
  if text.has_prefix("0x") {
    @string.parse_int(text[2:].to_owned(), base=16)
  } else {
    @string.parse_int(text)
  }
}

///|
fn byte_escape(value : Int) -> String {
  let digits = "0123456789abcdef"
  "\\x" +
  digits[(value >> 4) & 15].to_char().unwrap().to_string() +
  digits[value & 15].to_char().unwrap().to_string()
}

///|
async fn main {
  let args = @env.args()[1:]
  let (source_path, output_dir, manifest_path, microsoft) = match args {
    [source, output, manifest] => (source, output, manifest, false)
    ["microsoft", archive, output, manifest] =>
      (archive, output, manifest, true)
    _ =>
      fail(
        "usage: generate_codepages.mbtx SOURCE_DIRECTORY OUTPUT_DIRECTORY MANIFEST_JSON\n" +
        "   or: generate_codepages.mbtx microsoft ARCHIVE_ZIP OUTPUT_DIRECTORY MANIFEST_JSON",
      )
  }
  let archive_url = "https://download.microsoft.com/download/c/f/7/cf713a5e-9fbc-4fd6-9246-275f65c0e498/Windows%20Supported%20Code%20Page%20Data%20Files.zip"
  let archive_sha256 = "5074e6dd253056ba61fc6c870c9a955467855129c6ad3a51761c386b301b125a"
  if microsoft {
    let archive = @fs.read_file(source_path).binary()
    assert_eq(
      @crypto.bytes_to_hex_string(@crypto.sha256(archive)),
      archive_sha256,
    )
    assert_eq(archive.length(), 4020112)
  }
  let pages = if microsoft {
    [
      37, 437, 500, 708, 720, 737, 775, 850, 852, 855, 857, 858, 860, 861, 862, 863,
      864, 865, 866, 869, 870, 875, 1026, 1047, 1140, 1141, 1142, 1143, 1144, 1145,
      1146, 1147, 1148, 1149, 10000, 10001, 10002, 10003, 10004, 10005, 10006, 10007,
      10008, 10010, 10017, 10021, 10029, 10079, 10081, 10082, 20000, 20001, 20002,
      20003, 20004, 20005, 20105, 20106, 20107, 20108, 20127, 20261, 20269, 20273,
      20277, 20278, 20280, 20284, 20285, 20290, 20297, 20420, 20423, 20424, 20833,
      20838, 20866, 20871, 20880, 20905, 20924, 21025, 21027, 21866, 28591, 28592,
      28593, 28594, 28595, 28596, 28597, 28598, 28599, 28603, 28605, 29001,
    ]
  } else {
    [
      874, 932, 936, 949, 950, 1250, 1251, 1252, 1253, 1254, 1255, 1256, 1257, 1258,
      1361,
    ]
  }
  assert_eq(pages.length(), if microsoft { 96 } else { 15 })
  let evidence : Array[Json] = []
  let excluded : Array[Json] = []
  let dispatch = StringBuilder()
  let dispatch_name = if microsoft {
    "microsoft_codepage_table"
  } else {
    "codepage_table"
  }
  dispatch.write_string(
    "// Generated by scripts/generate_codepages.mbtx.\n///|\nfn " +
    dispatch_name +
    "(codepage : Int) -> (Bytes, Int)? {\n  match codepage {\n",
  )
  for page in pages {
    let filename = if microsoft {
      "CodpageFiles/" +
      (if page == 37 { "037" } else { page.to_string() }) +
      ".txt"
    } else {
      "bestfit" + page.to_string() + ".txt"
    }
    let source_url = if microsoft {
      archive_url
    } else {
      "https://www.unicode.org/Public/MAPPINGS/VENDORS/MICSFT/WindowsBestFit/" +
      filename
    }
    let bytes = if microsoft {
      // Extract exactly the member of the hash-verified official archive;
      // an unrelated or modified extracted directory cannot supply mappings.
      let (code, stdout, stderr) = @process.collect_output("unzip", [
        "-p", source_path, filename,
      ])
      guard code == 0 else { fail("unzip failed: " + stderr.text()) }
      stdout.binary()
    } else {
      @fs.read_file(source_path + "/" + filename).binary()
    }
    // Only ASCII numeric columns participate; comments may use legacy encodings.
    let source = @utf8.decode_lossy(bytes)
    let mappings : Array[(Int, Int)] = []
    let mut count = -1
    let mut fallback = -1
    let mut maximum_size = -1
    let mut in_table = false
    for line in source.split("\n") {
      let fields = words(line.to_owned())
      match fields {
        ["CODEPAGE", value, ..] => assert_eq(number(value), page)
        ["CPINFO", size, value, ..] => {
          maximum_size = number(size)
          fallback = number(value)
        }
        ["WCTABLE", value, ..] => {
          count = number(value)
          in_table = true
        }
        ["ENDCODEPAGE", ..] => in_table = false
        [key, value, ..] if in_table =>
          mappings.push((number(key), number(value)))
        _ => ()
      }
    }
    assert_eq(mappings.length(), count)
    assert_true(maximum_size == 1 || maximum_size == 2)
    assert_true(fallback >= 0 && fallback <= 65535)
    let sha = @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
    mappings.sort_by((left, right) => left.0.compare(right.0))
    let unique : Array[(Int, Int)] = []
    let conflicts : Array[Json] = []
    for index, pair in mappings {
      if index > 0 && pair.0 == mappings[index - 1].0 {
        if pair.1 != mappings[index - 1].1 {
          conflicts.push({
            "unicode_word": pair.0,
            "encoded_values": [mappings[index - 1].1, pair.1],
          })
        }
      } else {
        unique.push(pair)
      }
    }
    if !conflicts.is_empty() {
      guard microsoft else { fail("conflicting Unicode mapping data") }
      let exclusion : Json = {
        "codepage": page,
        "archive_member": filename,
        "source_sha256": sha,
        "source_bytes": bytes.length(),
        "source_entries": count,
        "reason": "conflicting WCTABLE mappings; requires direct Windows evidence before enabling",
        "conflicts": @json.to_json(conflicts),
      }
      excluded.push(exclusion)
      println("Excluded ambiguous source: " + exclusion.stringify())
      continue
    }
    let packed = @buffer.Buffer()
    let literal = StringBuilder()
    let mut previous = -1
    for index, (key, value) in unique {
      if index > 0 && index % 16 == 0 {
        literal.write_string("\",\n  b\"")
      }
      guard key > previous && key <= 65535 && value >= 0 && value <= 65535 else {
        fail(
          "invalid mapping: page=\{page}, key=\{key}, value=\{value}, previous=\{previous}",
        )
      }
      if maximum_size == 1 && value > 255 {
        fail(
          "wide mapping in single-byte page: page=\{page}, key=\{key}, value=\{value}",
        )
      }
      previous = key
      for byte in [key >> 8, key & 255, value >> 8, value & 255] {
        packed.write_byte(byte.to_byte())
        literal.write_string(byte_escape(byte))
      }
    }
    let notice = if microsoft {
      "// Microsoft CODEPAGEFILES data; see third_party/microsoft/LICENSE.txt.\n"
    } else {
      "// Unicode/Microsoft WindowsBestFit data; see third_party/unicode/LICENSE.txt.\n"
    }
    let generated = notice +
      "// Source: " +
      source_url +
      (if microsoft { "#" + filename } else { "" }) +
      "\n" +
      "// Source SHA-256: " +
      sha +
      "\n" +
      "// Generated by scripts/generate_codepages.mbtx; sorted big-endian (UTF-16, encoded value) pairs.\n///|\n" +
      "let cp_" +
      page.to_string() +
      " : Bytes = join_chunks([\n  b\"" +
      literal.to_string() +
      "\",\n])\n"
    @fs.write_file(output_dir + "/cp_" + page.to_string() + ".mbt", generated)
    dispatch.write_string(
      "    " +
      page.to_string() +
      " => Some((cp_" +
      page.to_string() +
      ", " +
      fallback.to_string() +
      "))\n",
    )
    let entry : Json = {
      "codepage": page,
      "source_url": source_url,
      "source_sha256": sha,
      "source_bytes": bytes.length(),
      "entries": unique.length(),
      "packed_sha256": @crypto.bytes_to_hex_string(
        @crypto.sha256(packed.to_bytes()),
      ),
      "default_character": fallback,
    }
    if microsoft {
      guard entry is Object(fields) else { fail("expected object") }
      fields["archive_member"] = @json.to_json(filename)
      fields["maximum_character_bytes"] = @json.to_json(maximum_size)
      fields["source_entries"] = @json.to_json(count)
    }
    evidence.push(entry)
  }
  dispatch.write_string(
    if microsoft {
      "    _ => None\n  }\n}\n"
    } else {
      "    _ => microsoft_codepage_table(codepage)\n  }\n}\n"
    },
  )
  let dispatch_file = if microsoft {
    "microsoft_tables.mbt"
  } else {
    "tables.mbt"
  }
  @fs.write_file(output_dir + "/" + dispatch_file, dispatch.to_string())
  let manifest : Json = {
    "schema_version": 1,
    "license": if microsoft {
      "LicenseRef-Microsoft-Open-Specifications"
    } else {
      "Unicode-3.0"
    },
    "pages": @json.to_json(evidence),
  }
  if microsoft {
    guard manifest is Object(fields) else { fail("expected object") }
    fields["archive_url"] = @json.to_json(archive_url)
    fields["archive_sha256"] = @json.to_json(archive_sha256)
    fields["archive_bytes"] = 4020112
    fields["specification_url"] = "https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-ucoderef/d167d756-0c58-4564-a0de-77c647d367fa"
    fields["notice_url"] = "https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-ucoderef/4a045e08-fc29-4f22-baf4-16f38c2825fb"
    fields["excluded_pages"] = @json.to_json(excluded)
  }
  @fs.write_file(manifest_path, manifest.stringify(indent=2) + "\n")
  println(
    "Generated " +
    evidence.length().to_string() +
    " code pages with source and packed-data digests; excluded " +
    excluded.length().to_string() +
    " ambiguous source pages",
  )
}
