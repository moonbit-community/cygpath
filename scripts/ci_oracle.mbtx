///|
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/async@0.22.4/process",
  "moonbitlang/async@0.22.4/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.5/crypto",
  "moonbitlang/x@0.5.5/sys",
}

///|
struct Probe {
  program : String
  argv : Array[String]
  cwd : String
  status : String
  exit_code : Int?
  reason : String?
  stdout_path : String
  stdout_sha256 : String
  stdout_length : Int
  stderr_path : String
  stderr_sha256 : String
  stderr_length : Int
  start_unix_ms : UInt64
  elapsed_ms : Int64
  deadline_ms : Int
} derive(ToJson)

///|
struct GateCase {
  profile : String
  suite : String
  mode : String
  backend : String
  case_id : String
  validation_domain : String
  raw_status : String
  gate_status : String
  reason : String?
  oracle_stdout_sha256 : String?
  oracle_stderr_sha256 : String?
  oracle_exit_code : Int?
  project_stdout_sha256 : String?
  project_stderr_sha256 : String?
  project_exit_code : Int?
} derive(ToJson)

///|
fn require(condition : Bool, message : String) -> Unit raise {
  if !condition {
    fail(message)
  }
}

///|
fn digest(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(result) else {
    fail("missing JSON field: " + key)
  }
  result
}

///|
fn text_field(value : Json, key : String) -> String raise {
  @json.from_json(field(value, key))
}

///|
fn int_field(value : Json, key : String) -> Int raise {
  @json.from_json(field(value, key))
}

///|
fn bool_field(value : Json, key : String) -> Bool raise {
  @json.from_json(field(value, key))
}

///|
fn optional_field(value : Json, key : String) -> Json? {
  match value {
    Object(fields) => fields.get(key)
    _ => None
  }
}

///|
fn path_text(value : String) -> String {
  value.replace_all(old="\\", new="/")
}

///|
fn trimmed(value : String) -> String {
  value.trim().to_owned()
}

///|
async fn save_json(path : String, value : Json) -> Unit {
  @fs.write_file(path, value.stringify(indent=2) + "\n")
}

///|
async fn artifact(path : String) -> Json {
  let path = path_text(@fs.realpath(path))
  let bytes = @fs.read_file(path).binary()
  { "path": path, "sha256": digest(bytes) }
}

///|
async fn package_metadata(
  directory : String,
  relative : String,
  output : String,
  entries : Array[Json],
) -> Unit {
  let path = if relative == "" { directory } else { directory + "/" + relative }
  for name in @fs.readdir(path) {
    let child_relative = if relative == "" {
      name
    } else {
      relative + "/" + name
    }
    let child = directory + "/" + child_relative
    if @fs.kind(child, follow_symlink=false) is Directory {
      package_metadata(directory, child_relative, output, entries)
    } else {
      let metadata = name == "setup.xz" ||
        name == "setup.ini" ||
        name == "setup.bz2" ||
        name.has_suffix(".sig")
      let runtime_archive = name.has_prefix("cygwin-") &&
        (
          name.has_suffix(".tar.xz") ||
          name.has_suffix(".tar.zst") ||
          name.has_suffix(".tar.bz2")
        )
      if metadata || runtime_archive {
        let bytes = @fs.read_file(child).binary()
        let retained = if metadata {
          let retained = "observations/package-metadata-" +
            entries.length().to_string() +
            ".bin"
          @fs.write_file(output + "/" + retained, bytes, create_mode=CreateNew)
          retained
        } else {
          "digest-only-package-archive"
        }
        entries.push({
          "cache_relative_path": child_relative,
          "sha256": digest(bytes),
          "length": bytes.length(),
          "retained": retained,
        })
      }
    }
  }
}

///|
async fn retain_installer_evidence(root : String, output : String) -> Unit {
  let entries : Array[Json] = []
  if @env.get_env_var("ORACLE_SETUP_EXE") is Some(path) && path != "" {
    entries.push({ "kind": "setup-executable", "artifact": artifact(path) })
  }
  let installed = root + "/etc/setup/installed.db"
  if @fs.exists(installed) {
    let bytes = @fs.read_file(installed).binary()
    let retained = "observations/installed.db"
    @fs.write_file(output + "/" + retained, bytes, create_mode=CreateNew)
    entries.push({
      "kind": "installed-packages",
      "path": installed,
      "sha256": digest(bytes),
      "length": bytes.length(),
      "retained": retained,
    })
  }
  if @env.get_env_var("ORACLE_PACKAGE_CACHE") is Some(path) && path != "" {
    require(@fs.exists(path), "action package-cache output does not exist")
    package_metadata(path_text(@fs.realpath(path)), "", output, entries)
  }
  save_json(output + "/installer-evidence.json", {
    "schema_version": 1,
    "entries": @json.to_json(entries),
  })
}

///|
async fn locate_tool(name : String) -> String {
  let path = @env.get_env_var("PATH").unwrap_or("")
  for directory in path.split(";") {
    let candidate = path_text(directory.to_owned()) + "/" + name
    if @fs.exists(candidate) {
      return path_text(@fs.realpath(candidate))
    }
  }
  fail("required observation tool is absent: " + name)
}

///|
async fn probe(
  output : String,
  name : String,
  program : String,
  argv : Array[String],
  cwd : String,
  environment : Map[String, String],
  deadline? : Int = 30000,
) -> Probe {
  println("ci_oracle: starting " + name)
  let stdout_path = "observations/" + name + ".stdout.bin"
  let stderr_path = "observations/" + name + ".stderr.bin"
  let start_unix_ms = @env.now()
  let start = @async.now()
  let mut code : Int? = None
  let mut status = "completed"
  let mut reason : String? = None
  try {
    code = @async.with_timeout_opt(deadline, () => {
      @process.run(
        program,
        argv,
        cwd~,
        extra_env=environment,
        inherit_env=false,
        stdin=@process.redirect_from_file(output + "/empty.bin"),
        stdout=@process.redirect_to_file(
          output + "/" + stdout_path,
          create_mode=CreateNew,
        ),
        stderr=@process.redirect_to_file(
          output + "/" + stderr_path,
          create_mode=CreateNew,
        ),
        cancel_handler=@process.hard_cancel(),
      )
    })
    if code is None {
      status = "timeout"
      reason = Some(
        "observation process exceeded its deadline; hard cancellation requested",
      )
    }
  } catch {
    error => {
      status = "error"
      reason = Some(error.to_string())
    }
  }
  for path in [stdout_path, stderr_path] {
    if !@fs.exists(output + "/" + path) {
      @fs.write_file(output + "/" + path, b"", create_mode=CreateNew)
    }
  }
  let stdout = @fs.read_file(output + "/" + stdout_path).binary()
  let stderr = @fs.read_file(output + "/" + stderr_path).binary()
  let result : Probe = {
    program,
    argv,
    cwd,
    status,
    exit_code: code,
    reason,
    stdout_path,
    stdout_sha256: digest(stdout),
    stdout_length: stdout.length(),
    stderr_path,
    stderr_sha256: digest(stderr),
    stderr_length: stderr.length(),
    start_unix_ms,
    elapsed_ms: @async.now() - start,
    deadline_ms: deadline,
  }
  save_json(output + "/observations/" + name + ".json", @json.to_json(result))
  result
}

///|
async fn successful_text(output : String, result : Probe) -> String {
  require(
    result.status == "completed" && result.exit_code == Some(0),
    "required observation failed: " + result.stdout_path,
  )
  trimmed(
    @utf8.decode(@fs.read_file(output + "/" + result.stdout_path).binary()),
  )
}

///|
fn drive_prefix(observed : String) -> String raise {
  let path = observed.trim_end(chars="/").to_owned()
  require(
    path.has_suffix("/c"),
    "unexpected official C-drive prefix: " + observed,
  )
  let prefix = path[:path.length() - 2].to_owned()
  if prefix == "" {
    "/"
  } else {
    prefix
  }
}

///|
fn drive_mount(posix : String, prefix : String) -> Bool {
  let head = if prefix == "/" { "/" } else { prefix + "/" }
  if posix.has_prefix(head) {
    let suffix = posix[head.length():]
    suffix.length() == 1 && suffix[0] >= 'a' && suffix[0] <= 'z'
  } else {
    false
  }
}

///|
fn mounted_context(raw : String, prefix : String) -> Array[Json] {
  let mounts : Array[Json] = []
  let seen : Map[String, Bool] = Map([])
  for line in raw.split("\n") {
    let sides = line.split(" on ").to_array()
    if sides.length() == 2 {
      let tail = sides[1].split(" type ").to_array()
      if tail.length() == 2 {
        let posix = trimmed(tail[0].to_owned())
        let windows = path_text(trimmed(sides[0].to_owned()))
        let ordinary = posix.has_prefix("/") &&
          posix != "/dev" &&
          !posix.has_prefix("/dev/") &&
          posix != "/proc" &&
          !posix.has_prefix("/proc/") &&
          !drive_mount(posix, prefix)
        if ordinary &&
          windows.length() >= 3 &&
          windows[1] == ':' &&
          !seen.contains(posix) {
          mounts.push({
            "posix": posix,
            "windows": windows,
            "case_policy": if tail[1].contains("posix=0") {
              "ascii-insensitive"
            } else {
              "sensitive"
            },
          })
          seen[posix] = true
        }
      }
    }
  }
  mounts
}

///|
fn observation_signature(observation : Json) -> String raise {
  text_field(field(observation, "stdout"), "sha256") +
  ":" +
  int_field(field(observation, "stdout"), "length").to_string() +
  ":" +
  text_field(field(observation, "stderr"), "sha256") +
  ":" +
  int_field(field(observation, "stderr"), "length").to_string() +
  ":" +
  int_field(observation, "exit_code").to_string()
}

///|
async fn verify_blob(directory : String, blob : Json) -> Bytes {
  let path = text_field(blob, "path")
  require(
    path != "" &&
    !path.contains(":") &&
    !path.contains("\\") &&
    path.split("/").all(part => part != "" && part != "." && part != ".."),
    "unsafe run-relative evidence path",
  )
  let bytes = @fs.read_file(directory + "/" + path).binary()
  require(
    bytes.length() == int_field(blob, "length") &&
    digest(bytes) == text_field(blob, "sha256"),
    "oracle evidence byte length/hash differs from recorded reference",
  )
  bytes
}

///|
async fn validate_run(
  directory : String,
  profile : String,
  suite : String,
  mode : String,
  backend : String,
  manifest_path : String,
  fixture_path : String,
  collector_exit : Int?,
  signatures : Map[String, String],
  results : Array[GateCase],
) -> Bool {
  let run = @json.parse(@fs.read_file(directory + "/run.json").text())
  require(
    int_field(run, "schema_version") == 1 &&
    text_field(run, "profile") == profile &&
    text_field(run, "mode") == mode &&
    text_field(run, "validation_kind") == "official-comparison",
    "unexpected oracle run schema/identity",
  )
  let fixture_bytes = verify_blob(directory, field(run, "fixtures"))
  require(
    digest(fixture_bytes) == digest(@fs.read_file(fixture_path).binary()),
    "oracle run fixture differs from requested immutable input",
  )
  let fixture = @json.parse(@utf8.decode(fixture_bytes))
  let expected_cases : Array[Json] = @json.from_json(field(fixture, "cases"))
  let expected_ids : Map[String, Json] = Map([])
  for fixture_case in expected_cases {
    let id = text_field(fixture_case, "case_id")
    require(!expected_ids.contains(id), "duplicate fixture case_id")
    expected_ids[id] = fixture_case
  }
  let manifest_bytes = verify_blob(directory, field(run, "manifest"))
  require(
    manifest_bytes == @fs.read_file(manifest_path).binary(),
    "oracle run manifest differs from the exact requested immutable manifest",
  )
  let manifest = @json.parse(@utf8.decode(manifest_bytes))
  require(
    text_field(field(manifest, "project"), "backend") == backend,
    "wrong backend in oracle manifest",
  )
  require(
    bool_field(run, "complete") && bool_field(run, "integrity_verified"),
    "oracle run is incomplete or unverified: " + directory,
  )
  let cases : Array[Json] = @json.from_json(field(run, "cases"))
  require(
    cases.length() == expected_cases.length() &&
    cases.length() == int_field(run, "planned") &&
    int_field(run, "executed") == cases.length(),
    "oracle run skipped or omitted planned cases: " + directory,
  )
  let all_raw_pass = cases.all(result => text_field(result, "status") == "pass")
  require(
    collector_exit == Some(if all_raw_pass { 0 } else { 1 }),
    "collector exit does not match its completed raw comparison outcomes",
  )
  let seen : Map[String, Bool] = Map([])
  let mut accepted = true
  for result in cases {
    let case_id = text_field(result, "case_id")
    require(
      expected_ids.contains(case_id) && !seen.contains(case_id),
      "unexpected or duplicate oracle result case_id",
    )
    seen[case_id] = true
    let fixture_case = expected_ids.get(case_id).unwrap()
    let domain : String = optional_field(fixture_case, "validation_domain")
      .map(value => @json.from_json(value))
      .unwrap_or("supported")
    let raw_status = text_field(result, "status")
    let oracle = optional_field(result, "oracle")
    let project = optional_field(result, "project")
    let mut gate_status = raw_status
    let mut reason : String? = None
    for observation in [oracle, project] {
      if observation is Some(observation) {
        for key in ["stdin", "stdout", "stderr"] {
          ignore(verify_blob(directory, field(observation, key)))
        }
      }
    }
    if oracle is Some(oracle) &&
      project is Some(project) &&
      text_field(oracle, "execution_status") == "completed" &&
      text_field(project, "execution_status") == "completed" {
      // Independently recheck raw equality and backend/replay consistency.
      let oracle_signature = observation_signature(oracle)
      let project_signature = observation_signature(project)
      require(
        (raw_status == "pass") == (oracle_signature == project_signature),
        "run comparison status disagrees with raw evidence",
      )
      for
        (role, signature) in [
          ("oracle", oracle_signature),
          ("project", project_signature),
        ] {
        if (
            domain == "malformed-utf8" || domain == "unavailable-codepage-29001"
          ) &&
          role == "oracle" {
          continue
        }
        let key = suite + "/" + case_id + "/" + role
        match signatures.get(key) {
          Some(prior) if prior != signature => {
            gate_status = "inconsistent"
            reason = Some("backend or replay changed " + role + " bytes/status")
            accepted = false
          }
          None => signatures[key] = signature
          _ => ()
        }
      }
      if raw_status == "fail" &&
        gate_status != "inconsistent" &&
        domain == "supported" {
        reason = Some(
          "exact official equality is required; no difference exemptions are applied",
        )
        accepted = false
      }
      if (domain == "malformed-utf8" || domain == "unavailable-codepage-29001") &&
        gate_status != "inconsistent" {
        let prefix = text_field(field(manifest, "context"), "drive_prefix")
        let drive_c = prefix.trim_end(chars="/").to_owned() + "/c"
        let expected_stdout = text_field(fixture_case, "boundary_stdout").replace_all(
          old="{drive_c}",
          new=drive_c,
        )
        let expected_stderr = text_field(fixture_case, "boundary_stderr")
        if text_field(field(project, "stdout"), "sha256") ==
          digest(@utf8.encode(expected_stdout)) &&
          text_field(field(project, "stderr"), "sha256") ==
          digest(@utf8.encode(expected_stderr)) &&
          int_field(project, "exit_code") ==
          int_field(fixture_case, "boundary_exit") {
          if domain == "malformed-utf8" {
            gate_status = "input-domain-boundary"
            reason = Some(
              "malformed UTF-8 is outside upstream defined conversion; raw oracle observation retained and strict project rejection verified independently",
            )
          } else {
            gate_status = "capability-boundary"
            reason = Some(
              "CP29001 Windows API failure is independently measured; upstream ignores the failed conversion and has no defined output; raw observation retained and exact project rejection verified",
            )
          }
        } else {
          gate_status = "boundary-contract-fail"
          reason = Some("strict unsupported-input rejection contract failed")
        }
      }
    } else {
      accepted = false
      reason = Some(
        "both actual processes must complete before a comparison can be accepted",
      )
    }
    if gate_status != "pass" &&
      gate_status != "input-domain-boundary" &&
      gate_status != "capability-boundary" {
      accepted = false
    }
    results.push({
      profile,
      suite,
      mode,
      backend,
      case_id,
      validation_domain: domain,
      raw_status,
      gate_status,
      reason,
      oracle_stdout_sha256: oracle.map(value => {
        text_field(field(value, "stdout"), "sha256")
      }),
      oracle_stderr_sha256: oracle.map(value => {
        text_field(field(value, "stderr"), "sha256")
      }),
      oracle_exit_code: oracle.map(value => int_field(value, "exit_code")),
      project_stdout_sha256: project.map(value => {
        text_field(field(value, "stdout"), "sha256")
      }),
      project_stderr_sha256: project.map(value => {
        text_field(field(value, "stderr"), "sha256")
      }),
      project_exit_code: project.map(value => int_field(value, "exit_code")),
    })
  }
  accepted
}

///|
fn parse_options(args : ArrayView[String]) -> Map[String, String] raise {
  let options : Map[String, String] = Map([])
  let valid = [
    "--profile", "--root", "--wasm", "--native", "--moon", "--moonrun", "--out",
    "--source-revision", "--context-variant",
  ]
  for index = 0; index < args.length(); {
    let name = args[index]
    require(
      valid.contains(name) && index + 1 < args.length(),
      "invalid/missing CI oracle option: " + name,
    )
    require(!options.contains(name), "duplicate option: " + name)
    options[name] = args[index + 1]
    continue index + 2
  }
  for name in valid[:7] {
    require(options.contains(name), "required option absent: " + name)
  }
  options
}

///|
async fn audit_scope(
  repository : String,
  output : String,
  profile : String,
  variant : String,
  results : Array[GateCase],
) -> Bool {
  let bytes = @fs.read_file(repository + "/testdata/oracle/p3-scope.json").binary()
  @fs.write_file(output + "/scope.json", bytes, create_mode=CreateNew)
  let scope = @json.parse(@utf8.decode(bytes))
  require(
    int_field(scope, "schema_version") == 1 &&
    text_field(scope, "validation_kind") == "p3-scope",
    "unexpected P3 scope schema",
  )
  let rows : Array[Json] = @json.from_json(field(scope, "rows"))
  let audit : Array[Json] = []
  let covered : Map[String, Bool] = Map([])
  let row_ids : Map[String, Bool] = Map([])
  let mut complete = true
  let excluded : Array[Json] = []
  let mut planned_cases = 0
  for row in rows {
    let id = text_field(row, "id")
    require(!row_ids.contains(id), "duplicate scope row")
    row_ids[id] = true
    let variants : Array[String] = optional_field(row, "variants")
      .map(value => @json.from_json(value))
      .unwrap_or(["default", "custom"])
    if !variants.contains(variant) {
      excluded.push({
        "id": id,
        "reason": "outside selected context variant",
        "variants": @json.to_json(variants),
      })
      continue
    }
    let cases : Array[Json] = @json.from_json(field(row, "cases"))
    require(!cases.is_empty(), "empty scope capability row")
    let evidence : Array[Json] = []
    for item in cases {
      let profiles : Array[String] = @json.from_json(field(item, "profiles"))
      if !profiles.contains(profile) {
        continue
      }
      let suite = text_field(item, "suite")
      planned_cases += 1
      let case_id = text_field(item, "case_id")
      require(
        !covered.contains(suite + "/" + case_id),
        "scope assigns the same case more than once for selected profile/context",
      )
      let domain = text_field(item, "validation_domain")
      let matching = results.filter(result => {
        result.suite == suite && result.case_id == case_id
      })
      let identities : Map[String, Bool] = Map([])
      let verified = matching.length() == 4 &&
        matching.all(result => {
          let key = result.mode + "/" + result.backend
          let unique = !identities.contains(key)
          identities[key] = true
          unique &&
          ["collect", "replay"].contains(result.mode) &&
          ["wasm", "native"].contains(result.backend) &&
          result.validation_domain == domain &&
          (if domain == "supported" {
            result.gate_status == "pass"
          } else {
            (
              domain == "malformed-utf8" &&
              result.gate_status == "input-domain-boundary"
            ) ||
            (
              domain == "unavailable-codepage-29001" &&
              result.gate_status == "capability-boundary"
            )
          })
        })
      if !verified {
        complete = false
      }
      covered[suite + "/" + case_id] = true
      evidence.push({
        "suite": suite,
        "case_id": case_id,
        "validation_domain": domain,
        "verified": verified,
        "observations": @json.to_json(matching),
      })
    }
    audit.push({ "id": id, "evidence": @json.to_json(evidence) })
  }
  let unmapped = results.filter(result => {
    !covered.contains(result.suite + "/" + result.case_id)
  })
  if !unmapped.is_empty() {
    complete = false
  }
  save_json(output + "/coverage-audit.json", {
    "schema_version": 1,
    "profile": profile,
    "context_variant": variant,
    "planned_cases": planned_cases,
    "planned_comparisons": planned_cases * 4,
    "out_of_variant_rows": @json.to_json(excluded),
    "scope_sha256": digest(bytes),
    "complete": complete,
    "rows": @json.to_json(audit),
    "unmapped_observations": @json.to_json(unmapped),
  })
  complete
}

///|
async fn run(options : Map[String, String]) -> Unit {
  require(
    @async.platform is Windows,
    "CI official-oracle orchestration requires Windows",
  )
  let profile = options.get("--profile").unwrap()
  let variant = options.get("--context-variant").unwrap_or("default")
  require(
    variant == "default" || variant == "custom",
    "unknown context variant",
  )
  require(profile == "cygwin" || profile == "msys2", "unknown profile")
  let root = path_text(@fs.realpath(options.get("--root").unwrap()))
  let bin = root + (if profile == "cygwin" { "/bin" } else { "/usr/bin" })
  let cygpath = bin + "/cygpath.exe"
  let runtime = bin +
    (if profile == "cygwin" { "/cygwin1.dll" } else { "/msys-2.0.dll" })
  require(
    @fs.exists(cygpath) && @fs.exists(runtime),
    "selected installation lacks matching cygpath/runtime",
  )
  let moon = path_text(@fs.realpath(options.get("--moon").unwrap()))
  let moonrun = path_text(@fs.realpath(options.get("--moonrun").unwrap()))
  let wasm = path_text(@fs.realpath(options.get("--wasm").unwrap()))
  let native = path_text(@fs.realpath(options.get("--native").unwrap()))
  let repository = path_text(@fs.realpath("."))
  @fs.mkdir(options.get("--out").unwrap())
  let output = path_text(@fs.realpath(options.get("--out").unwrap()))
  @fs.mkdir(output + "/observations")
  @fs.write_file(output + "/empty.bin", b"", create_mode=CreateNew)
  retain_installer_evidence(root, output)
  let cwd = "C:/cygpath-ci/" + profile + "/cwd"
  @fs.mkdir(cwd, recursive=true, allow_exist=true)
  let environment : Map[String, String] = Map([])
  for
    name in [
      "WINDIR", "COMSPEC", "TEMP", "TMP", "USERPROFILE", "HOME", "HOMEDRIVE", "HOMEPATH",
      "MOON_HOME", "APPDATA", "LOCALAPPDATA", "SystemDrive", "ProgramFiles", "ProgramFiles(x86)",
      "ProgramW6432", "ProgramData", "PSModulePath", "PATHEXT", "OS", "PROCESSOR_ARCHITECTURE",
      "NUMBER_OF_PROCESSORS", "USERNAME", "USERDOMAIN",
    ] {
    if @env.get_env_var(name) is Some(value) {
      environment[name] = value
    }
  }
  environment["PATH"] = bin + ";" + @env.get_env_var("PATH").unwrap_or("")
  environment["LANG"] = "C.UTF-8"
  environment["LC_ALL"] = "C.UTF-8"
  environment["MSYS2_ARG_CONV_EXCL"] = "*"
  environment["MSYS2_ENV_CONV_EXCL"] = "*"
  environment["CYGWIN"] = "noglob"
  environment["MSYS"] = "noglob"
  let system_root = @env.get_env_var("SystemRoot").unwrap_or(
    @env.get_env_var("SYSTEMROOT").unwrap_or(""),
  )
  require(system_root != "", "Windows SystemRoot environment is absent")
  environment["SystemRoot"] = system_root
  save_json(output + "/environment.json", @json.to_json(environment))
  let powershell = locate_tool("pwsh.exe")
  let probe_environment = environment.copy()
  probe_environment["CYGPATH_CI_CWD"] = cwd
  let startup = probe(
    output,
    "powershell-startup",
    powershell,
    [
      "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[Console]::Error.WriteLine('pwsh: startup'); [Console]::Out.Write('cygpath-pwsh-ready')",
    ],
    cwd,
    probe_environment,
  )
  require(
    successful_text(output, startup) == "cygpath-pwsh-ready",
    "PowerShell startup probe returned unexpected output",
  )
  let windows_query =
    #|[Console]::Error.WriteLine('host: startup')
    #|$ErrorActionPreference = 'Stop'
    #|[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
    #|[Console]::Error.WriteLine('host: item')
    #|$p = Get-Item -LiteralPath $env:CYGPATH_CI_CWD
    #|[Console]::Error.WriteLine('host: drive')
    #|$v = [IO.DriveInfo]::new($p.PSDrive.Root)
    #|[Console]::Error.WriteLine('host: registry')
    #|$r = Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem'
    #|[Console]::Error.WriteLine('host: ACL')
    #|$sddl = (Get-Acl -LiteralPath $p.FullName).Sddl
    #|[Console]::Error.WriteLine('host: emit')
    #|[pscustomobject]@{os_version=[Environment]::OSVersion.VersionString; architecture=[Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString(); filesystem=$v.DriveFormat; test_volume=($v.Name + '; label=' + $v.VolumeLabel); input_code_page=[Console]::InputEncoding.CodePage.ToString(); output_code_page=[Console]::OutputEncoding.CodePage.ToString(); long_path_policy=('LongPathsEnabled=' + $r.LongPathsEnabled); short_name_policy=('NtfsDisable8dot3NameCreation=' + $r.NtfsDisable8dot3NameCreation); existence_permissions=($p.FullName + '; attributes=' + $p.Attributes + '; SDDL=' + $sddl); symlinks_junctions=('cwd LinkType=' + $p.LinkType + '; Target=' + $p.Target + '; Attributes=' + $p.Attributes)} | ConvertTo-Json -Compress
  let host_probe = probe(
    output,
    "windows-host",
    powershell,
    ["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", windows_query],
    cwd,
    probe_environment,
  )
  let host = @json.parse(successful_text(output, host_probe))
  let codepage_probe = probe(
    output,
    "windows-codepage-api",
    moon,
    [
      "run",
      "--deny-warn",
      repository + "/scripts/probe_windows_codepages.mbtx",
      output + "/codepage-api-probe",
      powershell,
    ],
    repository,
    environment,
    deadline=120000,
  )
  ignore(successful_text(output, codepage_probe))
  let codepage_result = @json.parse(
    @fs.read_file(output + "/codepage-api-probe/result.json").text(),
  )
  require(
    bool_field(codepage_result, "assertions_passed"),
    "CP29001 capability boundary requires successful independent Windows API diagnosis",
  )
  let version = probe(
    output,
    "upstream-version",
    cygpath,
    ["--version"],
    cwd,
    environment,
  )
  ignore(successful_text(output, version))
  // Official runtime startup must deliver the recorded argv literally. Its
  // native-parent wildcard expansion is unrelated to path conversion.
  let argv_echo = bin + "/printf.exe"
  require(
    @fs.exists(argv_echo),
    "official installation lacks coreutils printf.exe for literal argv transport evidence",
  )
  let argv_echo_artifact = artifact(argv_echo)
  let transport : Array[Json] = []
  for
    (id, payload) in [
      ("extended-drive", "\\\\?\\C:\\work\\file"),
      ("extended-unc", "\\\\?\\UNC\\server\\share\\file"),
      ("literal-wildcards", "a?b*c[0]"),
    ] {
    let check = probe(
      output,
      "argv-transport-" + id,
      argv_echo,
      ["%s", payload],
      cwd,
      environment,
    )
    require(
      check.status == "completed" && check.exit_code == Some(0),
      "official runtime argv transport probe failed",
    )
    let expected = @utf8.encode(payload)
    require(
      @fs.read_file(output + "/" + check.stdout_path).binary() == expected &&
      check.stderr_length == 0,
      "official runtime startup changed literal argv despite noglob",
    )
    transport.push({
      "id": id,
      "payload": payload,
      "expected_stdout_sha256": digest(expected),
      "observation": @json.to_json(check),
    })
  }
  save_json(output + "/argv-transport.json", {
    "schema_version": 1,
    "verified": true,
    "argv_echo_program": argv_echo_artifact,
    "argv_echo_origin": "official coreutils printf.exe from the same selected installation as cygpath and its runtime",
    "argv_echo_protocol": "direct process argv [%s, payload]; exact single-payload bytes, no shell code or delimiter",
    "runtime_environment": { "CYGWIN": "noglob", "MSYS": "noglob" },
    "source_urls": [
      "https://github.com/cygwin/cygwin/blob/b11613e477c006b2ce0332463ed07f1118260e79/winsup/cygwin/environ.cc",
      "https://github.com/msys2/msys2-runtime/blob/c770e1b9fa537fff9287c1fd40ebc84ac498fcb6/winsup/cygwin/environ.cc",
    ],
    "probes": @json.to_json(transport),
  })
  let runtime_version = successful_text(
    output,
    probe(output, "runtime-uname", bin + "/uname.exe", ["-a"], cwd, environment),
  )
  let package_program = bin +
    (if profile == "cygwin" { "/cygcheck.exe" } else { "/pacman.exe" })
  let package_args = if profile == "cygwin" {
    ["-c", "cygwin"]
  } else {
    ["-Qi", "msys2-runtime"]
  }
  let package_identity = successful_text(
    output,
    probe(
      output, "runtime-package", package_program, package_args, cwd, environment,
    ),
  )
  let prepared : Array[Json] = [{ "path": cwd, "kind": "working-directory" }]
  let mut mount_holder : Int? = None
  let mut mount_holder_program : Json? = None
  if variant == "custom" {
    // Cygwin/MSYS user mounts are process-session state. Keep one official
    // runtime process alive while every collection/replay process observes it.
    let holder = bin + "/sleep.exe"
    require(
      @fs.exists(holder),
      "custom context requires official runtime sleep.exe to retain temporary mounts",
    )
    let holder_pid = @process.spawn_orphan(
      holder,
      ["1800"],
      extra_env=environment,
      inherit_env=false,
      cwd~,
      no_console_window=true,
    )
    require(holder_pid > 0, "custom mount session holder did not start")
    mount_holder = Some(holder_pid)
    mount_holder_program = Some(artifact(holder))
    save_json(output + "/custom-mount-session.json", {
      "schema_version": 1,
      "status": "started",
      "pid": holder_pid,
      "program": mount_holder_program.unwrap(),
      "lifetime_seconds": 1800,
      "reason": "temporary Cygwin/MSYS mounts disappear when the last runtime process exits",
      "source": "https://cygwin.com/cygwin-ug-net/mount.html",
    })
    for
      directory in [
        cwd + "/custom-base/nested",
        cwd + "/custom-nested",
        cwd + "/custom-shared/deep",
        cwd + "/custom-Fold",
        root + "/p3-mount/nested",
        root + "/p3-alias-first",
        root + "/p3-alias-second",
        root + "/p3-alias-deep",
        root + "/P3Fold",
      ] {
      @fs.mkdir(directory, recursive=true, allow_exist=true)
      require(
        @fs.kind(directory) is Directory,
        "custom mount preparation failed",
      )
      prepared.push({
        "path": path_text(@fs.realpath(directory)),
        "kind": "mount-directory",
      })
    }
    save_json(output + "/directory-preparation.json", {
      "schema_version": 1,
      "context_variant": variant,
      "directories": @json.to_json(prepared),
    })
    for
      (name, argv) in [
        ("set-custom-drive-prefix", ["-c", "/p3-drives"]),
        ("set-custom-base-mount", ["-f", cwd + "/custom-base", "/p3-mount"]),
        (
          "set-custom-nested-mount",
          ["-f", cwd + "/custom-nested", "/p3-mount/nested"],
        ),
        (
          "set-custom-first-alias",
          ["-f", cwd + "/custom-shared", "/p3-alias-first"],
        ),
        (
          "set-custom-second-alias",
          ["-f", cwd + "/custom-shared", "/p3-alias-second"],
        ),
        (
          "set-custom-deeper-alias",
          ["-f", cwd + "/custom-shared/deep", "/p3-alias-deep"],
        ),
        (
          "set-custom-fold-mount",
          ["-f", "-o", "posix=0", cwd + "/custom-Fold", "/P3Fold"],
        ),
      ] {
      ignore(
        successful_text(
          output,
          probe(output, name, bin + "/mount.exe", argv, cwd, environment),
        ),
      )
    }
  } else {
    save_json(output + "/directory-preparation.json", {
      "schema_version": 1,
      "context_variant": variant,
      "directories": @json.to_json(prepared),
    })
  }
  let mount_table = successful_text(
    output,
    probe(output, "mount-table", bin + "/mount.exe", [], cwd, environment),
  )
  let locale = successful_text(
    output,
    probe(output, "locale", bin + "/locale.exe", [], cwd, environment),
  )
  let official_root = path_text(
    successful_text(
      output,
      probe(output, "root-mapping", cygpath, ["-w", "/"], cwd, environment),
    ),
  )
  let usr_bin = path_text(
    successful_text(
      output,
      probe(
        output,
        "usr-bin-mapping",
        cygpath,
        ["-w", "/usr/bin"],
        cwd,
        environment,
      ),
    ),
  )
  let prefix = drive_prefix(
    successful_text(
      output,
      probe(output, "drive-prefix", cygpath, ["-u", "C:\\"], cwd, environment),
    ),
  )
  save_json(output + "/path-mapping-probes.json", {
    "root": official_root,
    "usr_bin": usr_bin,
    "context_mount_source": "Only declarations from the raw mount table are supplied to the project; queried path mappings do not create extra mounts.",
  })
  if variant == "custom" {
    require(
      prefix == "/p3-drives",
      "official runtime did not retain the configured custom drive prefix",
    )
    let mounted = mounted_context(mount_table, prefix)
    let mapping_observations : Array[Json] = []
    for
      (posix, windows) in [
        ("/p3-mount", cwd + "/custom-base"),
        ("/p3-mount/nested", cwd + "/custom-nested"),
        ("/p3-alias-first", cwd + "/custom-shared"),
        ("/p3-alias-second", cwd + "/custom-shared"),
        ("/p3-alias-deep", cwd + "/custom-shared/deep"),
        ("/P3Fold", cwd + "/custom-Fold"),
      ] {
      require(
        mounted.any(mount => {
          text_field(mount, "posix") == posix &&
          text_field(mount, "windows") == windows
        }),
        "official mount table does not match configured fixture mapping: " +
        posix,
      )
      let measured = path_text(
        successful_text(
          output,
          probe(
            output,
            "custom-mapping-" + posix.replace_all(old="/", new="-"),
            cygpath,
            ["-w", posix],
            cwd,
            environment,
          ),
        ),
      )
      let direct_target_match = measured.trim_end(chars="/").to_owned() ==
        windows
      mapping_observations.push({
        "posix": posix,
        "declared_windows_target": windows,
        "observed_windows_path": measured,
        "direct_target_match": direct_target_match,
        "probe": "observations/custom-mapping-" +
        posix.replace_all(old="/", new="-") +
        ".json",
      })
      // MSYS2 searches its separately sorted mount list; the existence of a
      // nested declaration does not prove that declaration wins selection.
      // Preserve the original declarations for product context and let the
      // ordinary collect/replay cases enforce exact official/project equality.
      if profile == "cygwin" {
        require(
          direct_target_match, "independent Cygwin custom mount mapping probe differs",
        )
      }
    }
    require(
      mounted.any(mount => {
        text_field(mount, "posix") == "/P3Fold" &&
        text_field(mount, "case_policy") == "ascii-insensitive"
      }),
      "official mount did not report requested posix=0 policy",
    )
    save_json(output + "/custom-mapping-observations.json", {
      "schema_version": 1,
      "profile": profile,
      "mount_declarations_verified": true,
      "observations": @json.to_json(mapping_observations),
      "selection_rule_source": if profile == "msys2" {
        "https://github.com/msys2/msys2-runtime/blob/c770e1b9fa537fff9287c1fd40ebc84ac498fcb6/winsup/cygwin/mount.cc#L1420-L1500"
      } else {
        "https://github.com/cygwin/cygwin/blob/b11613e477c006b2ce0332463ed07f1118260e79/winsup/cygwin/mount.cc#L1330-L1405"
      },
      "acceptance": "Mount declarations are checked against the configured targets. These probes retain the official selection result; they do not replace declarations with observations or accept any official/project difference. All supported custom fixtures must still match stdout, stderr, and exit status exactly in both backends and replay.",
    })
  }
  let windows_cwd = path_text(
    successful_text(
      output,
      probe(output, "windows-cwd", cygpath, ["-aw", "."], cwd, environment),
    ),
  )
  let posix_cwd = successful_text(
    output,
    probe(output, "posix-cwd", cygpath, ["-au", "."], cwd, environment),
  )
  let drive_cwd = path_text(
    successful_text(
      output,
      probe(
        output,
        "drive-c-cwd",
        powershell,
        [
          "-NoProfile", "-NonInteractive", "-Command", "[Console]::WriteLine([IO.Path]::GetFullPath('C:.'))",
        ],
        cwd,
        environment,
      ),
    ),
  )
  require(
    drive_cwd.has_prefix("C:/") || drive_cwd.has_prefix("c:/"),
    "native C-drive cwd probe did not return a drive-absolute Windows path",
  )
  let git = locate_tool("git.exe")
  let git_sha = successful_text(
    output,
    probe(
      output,
      "project-git-sha",
      git,
      ["rev-parse", "HEAD"],
      repository,
      environment,
    ),
  )
  let git_dirty = successful_text(
    output,
    probe(
      output,
      "project-git-status",
      git,
      ["status", "--porcelain", "--untracked-files=no"],
      repository,
      environment,
    ),
  )
  let moon_version = successful_text(
    output,
    probe(
      output,
      "moon-version",
      moon,
      ["version", "--all"],
      repository,
      environment,
    ),
  )
  let source_revision = options
    .get("--source-revision")
    .unwrap_or(
      "measured distribution package release identity (source Git commit not independently attested):\n" +
      package_identity,
    )
  let module_text = @fs.read_file(repository + "/moon.mod").text()
  let mut module_version = ""
  for line in module_text.split("\n") {
    let line = trimmed(line.to_owned())
    if line.has_prefix("version = ") {
      module_version = trimmed(line[10:].to_owned()).trim(chars="\"").to_owned()
    }
  }
  require(module_version != "", "module version could not be read")
  let upstream : Json = {
    "executable": artifact(cygpath),
    "runtime_library": artifact(runtime),
    "source_url": if profile == "cygwin" {
      "https://github.com/cygwin/cygwin"
    } else {
      "https://github.com/msys2/msys2-runtime"
    },
    "source_revision": source_revision,
    "distribution_version": package_identity,
    "runtime_version": runtime_version,
    "version_stdout_sha256": version.stdout_sha256,
    "version_stderr_sha256": version.stderr_sha256,
    "version_exit_code": 0,
  }
  let manifest_base : Json = {
    "schema_version": 1,
    "profile": profile,
    "upstream": upstream,
    "host": {
      "os": "windows",
      "os_version": text_field(host, "os_version"),
      "architecture": text_field(host, "architecture"),
      "filesystem": text_field(host, "filesystem"),
      "installation_root": official_root,
      "launch_method": "direct-process-argv",
      "current_drive": "C",
      "drive_cwds": { "C": drive_cwd },
      "mount_table": mount_table,
      "cygdrive_prefix": prefix,
      "existence_permissions": text_field(host, "existence_permissions"),
      "locale": locale,
      "input_code_page": text_field(host, "input_code_page"),
      "output_code_page": text_field(host, "output_code_page"),
      "io_mode": "redirected-binary",
      "long_path_policy": text_field(host, "long_path_policy"),
      "short_name_policy": text_field(host, "short_name_policy"),
      "test_volume": text_field(host, "test_volume"),
      "actual_short_names": "not exercised by read-only fixtures",
      "symlinks_junctions": text_field(host, "symlinks_junctions"),
    },
    "cwd": cwd,
    "environment": @json.to_json(environment),
    "cleared_environment": ["MSYSTEM"],
    "context": {
      "profile": profile,
      "drive_prefix": prefix,
      "mounts": @json.to_json(mounted_context(mount_table, prefix)),
      "posix_cwd": posix_cwd,
      "windows_cwd": windows_cwd,
      "drive_cwds": { "C": drive_cwd },
    },
    "context_mapping_evidence": "Sibling observations retain raw mount/locale/cygpath cwd and mapping probes with their exact argv, bytes, status, and hashes. Per-drive C cwd is measured by the native Windows .NET Path.GetFullPath API on C:.; it is not inferred by converting the ambiguous C: operand with cygpath. Mounts are transcribed in observed order; auto cygdrive and virtual /dev,/proc entries are excluded. Mount case policy is transcribed from posix=0 and supplied explicitly. Root and /usr/bin mappings are independently queried. Custom declarations remain unchanged when MSYS2 selects another matching mount; custom-mapping-observations.json retains that distinction and strict fixture comparisons remain mandatory. Host facts come from the retained PowerShell observation; source Git provenance is separately qualified.",
    "capabilities": [
      "portable-paths", "utf8", "stdin", "root-mount", "usr-bin-mount", "posix-cwd",
      "windows-cwd", "drive-cwd-c",
    ],
    "deadline_ms": 10000,
  }
  let manifests : Map[String, String] = Map([])
  for (backend, executable) in [("wasm", wasm), ("native", native)] {
    let project : Json = {
      "artifact": artifact(executable),
      "launcher": artifact(if backend == "wasm" { moonrun } else { native }),
      "backend": backend,
      "git_sha": git_sha,
      "dirty": git_dirty != "",
      "module_version": module_version,
      "moon_version": moon_version,
      "build_mode": "release",
    }
    guard manifest_base is Object(fields) else {
      fail("manifest base must be object")
    }
    let fields = fields.copy()
    fields["project"] = project
    let path = output + "/manifest-" + backend + ".json"
    save_json(path, Json::object(fields))
    manifests[backend] = path
  }
  let signatures : Map[String, String] = Map([])
  let results : Array[GateCase] = []
  let infrastructure : Array[Json] = []
  let mut accepted = true
  let suites = [
    ("profile", repository + "/testdata/oracle/fixtures." + profile + ".json"),
    ("matrix", repository + "/testdata/oracle/fixtures.readonly-matrix.json"),
    ("p3", repository + "/testdata/oracle/fixtures.p3.json"),
  ]
  if variant == "custom" {
    suites.push(
      ("custom", repository + "/testdata/oracle/fixtures.custom.json"),
    )
  }
  let fixture_preparations : Array[Json] = []
  for (suite, path) in suites {
    let fixture = @json.parse(@fs.read_file(path).text())
    let cases : Array[Json] = @json.from_json(field(fixture, "cases"))
    for item in cases {
      if optional_field(item, "file_hex") is Some(hex) {
        fixture_preparations.push({
          "suite": suite,
          "case_id": text_field(item, "case_id"),
          "path": cwd +
          "/.cygpath-oracle-fixtures/" +
          text_field(item, "case_id") +
          ".bin",
          "file_hex": hex,
          "policy": "create-new or verify identical before and after each process; replay verifies identical bytes",
        })
      }
    }
  }
  save_json(output + "/fixture-preparation-plan.json", {
    "schema_version": 1,
    "context_variant": variant,
    "files": @json.to_json(fixture_preparations),
  })
  for (suite, fixtures) in suites {
    for backend in ["wasm", "native"] {
      let manifest = manifests.get(backend).unwrap()
      let collection = output + "/" + suite + "-" + backend + "-collect"
      let replay = output + "/" + suite + "-" + backend + "-replay"
      for
        (mode, source, directory) in [
          ("collect", fixtures, collection),
          ("replay", collection, replay),
        ] {
        let name = suite + "-" + backend + "-" + mode
        let execution = probe(
          output,
          name,
          moon,
          [
            "run",
            "--deny-warn",
            repository + "/scripts/oracle.mbtx",
            mode,
            manifest,
            source,
            directory,
          ],
          repository,
          environment,
          deadline=600000,
        )
        // oracle.mbtx exits 1 for raw comparison failures. The independently
        // checked run file distinguishes those from infrastructure failures.
        try {
          require(
            execution.status == "completed",
            "collector process did not complete: " + name,
          )
          if !validate_run(
              directory,
              profile,
              suite,
              mode,
              backend,
              manifest,
              fixtures,
              execution.exit_code,
              signatures,
              results,
            ) {
            accepted = false
          }
        } catch {
          error => {
            accepted = false
            infrastructure.push({
              "run": name,
              "diagnostic": error.to_string(),
              "execution": @json.to_json(execution),
            })
          }
        }
        save_json(output + "/summary.json", {
          "schema_version": 1,
          "profile": profile,
          "context_variant": variant,
          "complete": false,
          "accepted": false,
          "raw_results_preserved": true,
          "infrastructure_errors": @json.to_json(infrastructure),
          "cases": @json.to_json(results),
        })
      }
    }
  }
  if mount_holder is Some(holder_pid) {
    let stopped = probe(
      output,
      "stop-custom-mount-session",
      powershell,
      [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "Stop-Process -Id " +
        holder_pid.to_string() +
        " -Force -ErrorAction SilentlyContinue",
      ],
      cwd,
      probe_environment,
    )
    require(
      stopped.status == "completed" && stopped.exit_code == Some(0),
      "custom mount session holder did not stop",
    )
    save_json(output + "/custom-mount-session-stop.json", {
      "schema_version": 1,
      "status": "stopped",
      "pid": holder_pid,
      "observation": @json.to_json(stopped),
    })
    save_json(output + "/custom-mount-session.json", {
      "schema_version": 1,
      "status": "stopped",
      "pid": holder_pid,
      "program": mount_holder_program.unwrap(),
      "lifetime_seconds": 1800,
      "reason": "temporary Cygwin/MSYS mounts disappear when the last runtime process exits",
      "source": "https://cygwin.com/cygwin-ug-net/mount.html",
      "stop_observation": "custom-mount-session-stop.json",
    })
  }
  let mut coverage_verified = false
  try {
    coverage_verified = audit_scope(
      repository, output, profile, variant, results,
    )
  } catch {
    error =>
      infrastructure.push({
        "run": "coverage-audit",
        "diagnostic": error.to_string(),
      })
  }
  let fault = probe(
    output,
    "fault-drills",
    moon,
    [
      "run",
      "--deny-warn",
      repository + "/scripts/oracle.mbtx",
      "fault-drill",
      manifests.get("wasm").unwrap(),
      output + "/profile-wasm-collect",
      output + "/fault-drills",
      powershell,
    ],
    repository,
    environment,
    deadline=120000,
  )
  let mut fault_verified = false
  try {
    require(
      fault.status == "completed" && fault.exit_code == Some(0),
      "real Windows fault drills did not complete successfully",
    )
    let fault_summary = @json.parse(
      @fs.read_file(output + "/fault-drills/summary.json").text(),
    )
    require(
      text_field(fault_summary, "validation_kind") ==
      "real-windows-fault-drills" &&
      bool_field(fault_summary, "complete") &&
      int_field(fault_summary, "passed") == 5 &&
      int_field(fault_summary, "failed") == 0,
      "incomplete fault drill result",
    )
    fault_verified = true
  } catch {
    error =>
      infrastructure.push({
        "run": "fault-drills",
        "diagnostic": error.to_string(),
        "execution": @json.to_json(fault),
      })
  }
  accepted = accepted &&
    coverage_verified &&
    fault_verified &&
    infrastructure.is_empty()
  save_json(output + "/summary.json", {
    "schema_version": 1,
    "profile": profile,
    "context_variant": variant,
    "source_detection": "natural CLI auto-detection; source_type is descriptive fixture metadata only",
    "complete": infrastructure.is_empty(),
    "accepted": accepted,
    "raw_results_preserved": true,
    "comparisons": results.length(),
    "supported_exact_comparisons": results
    .filter(result => {
      result.validation_domain == "supported" && result.gate_status == "pass"
    })
    .length(),
    "input_domain_boundary_observations": results
    .filter(result => result.gate_status == "input-domain-boundary")
    .length(),
    "capability_boundary_observations": results
    .filter(result => result.gate_status == "capability-boundary")
    .length(),
    "coverage_verified": coverage_verified,
    "fault_drills_verified": fault_verified,
    "infrastructure_errors": @json.to_json(infrastructure),
    "cases": @json.to_json(results),
  })
  println("official oracle CI evidence: " + output)
  println(
    "profile=\{profile} comparisons=\{results.length()} accepted=\{accepted}",
  )
  require(
    accepted, "official comparisons require exact equality with zero infrastructure/backend failures",
  )
}

///|
fn self_test() -> Unit raise {
  assert_eq(drive_prefix("/cygdrive/c/"), "/cygdrive")
  assert_eq(drive_prefix("/c/"), "/")
  require(
    drive_mount("/cygdrive/c", "/cygdrive") && drive_mount("/c", "/"),
    "drive mount classification",
  )
  require(
    !drive_mount("/usr/bin", "/") &&
    !drive_mount("/cygdrive/c/work", "/cygdrive"),
    "ordinary mount misclassified",
  )
  let mounts = mounted_context(
    "C:/root on / type ntfs (binary)\nC: on /cygdrive/c type ntfs (binary)\nC:/root/bin on /usr/bin type ntfs (binary)",
    "/cygdrive",
  )
  assert_eq(mounts.length(), 2)
  assert_eq(text_field(mounts[1], "posix"), "/usr/bin")
  let folded = mounted_context(
    "C:/fold on /P3Fold type ntfs (binary,posix=0,user)", "/cygdrive",
  )
  assert_eq(text_field(folded[0], "case_policy"), "ascii-insensitive")
  assert_eq(folded.length(), 1)
  let raw_msys = mounted_context(
    "C:/msys64 on / type ntfs (binary,noacl,auto)\nC:/msys64/usr/bin on /bin type ntfs (binary,noacl,auto)",
    "/",
  )
  assert_eq(raw_msys.length(), 2)
  require(
    !raw_msys.any(mount => text_field(mount, "posix") == "/usr/bin"),
    "a queried mapping must not invent a mount absent from the raw table",
  )
  let oracle : Json = {
    "stdout": { "sha256": digest(b"official"), "length": 8 },
    "stderr": { "sha256": digest(b""), "length": 0 },
    "exit_code": 0,
  }
  let project : Json = {
    "stdout": { "sha256": digest(b"portable"), "length": 8 },
    "stderr": { "sha256": digest(b""), "length": 0 },
    "exit_code": 2,
  }
  require(
    observation_signature(oracle) != observation_signature(project),
    "different output/exit observations must remain unequal",
  )
  println("CI oracle parser self-test passed; no Windows compatibility tested")
}

///|
async fn main {
  try {
    let args = @env.args()[1:]
    if args is ["self-test"] {
      self_test()
    } else {
      run(parse_options(args))
    }
  } catch {
    error => {
      @stdio.stderr.write("ci_oracle: " + error.to_string() + "\n") catch {
        _ => ()
      }
      @sys.exit(1)
    }
  }
}
