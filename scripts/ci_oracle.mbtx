----
import {
  "moonbitlang/async@0.22.10",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/async@0.22.10/process",
  "moonbitlang/async@0.22.10/stdio",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.8/crypto",
}
----

///|
#derive(ToJson)
struct Probe {
  program : String
  argv : Array[String]
  cwd : String
  status : String
  exit_code : Int32?
  reason : String?
  stdout_path : String
  stdout_sha256 : String
  stdout_length : Int32
  stderr_path : String
  stderr_sha256 : String
  stderr_length : Int32
  start_unix_ms : UInt64
  elapsed_ms : Int64
  deadline_ms : Int32
}

///|
#derive(ToJson)
struct GateCase {
  profile : String
  suite : String
  mode : String
  backend : String
  case_id : String
  validation_domain : String
  raw_status : String
  gate_status : String
  reason : String?
  oracle_stdout_sha256 : String?
  oracle_stderr_sha256 : String?
  oracle_exit_code : Int32?
  project_stdout_sha256 : String?
  project_stderr_sha256 : String?
  project_exit_code : Int32?
}

///|
fn require(condition : Bool, message : String) -> Unit raise {
  if !condition {
    fail(message)
  }
}

///|
fn digest(bytes : Bytes) -> String {
  @crypto.bytes_to_hex_string(@crypto.sha256(bytes))
}

///|
fn field(value : Json, key : String) -> Json raise {
  guard value is Object(fields) && fields.get(key) is Some(result) else {
    fail("missing JSON field: " + key)
  }
  result
}

///|
fn text_field(value : Json, key : String) -> String raise {
  @json.from_json(field(value, key))
}

///|
fn int_field(value : Json, key : String) -> Int32 raise {
  @json.from_json(field(value, key))
}

///|
fn bool_field(value : Json, key : String) -> Bool raise {
  @json.from_json(field(value, key))
}

///|
fn optional_field(value : Json, key : String) -> Json? {
  match value {
    Object(fields) => fields.get(key)
    _ => None
  }
}

///|
fn path_text(value : String) -> String {
  value.replace_all(old="\\", new="/")
}

///|
fn trimmed(value : String) -> String {
  value.trim().to_owned()
}

///|
async fn save_json(path : String, value : Json) -> Unit {
  @fs.write_file(path, value.stringify(indent=2) + "\n")
}

///|
async fn artifact(path : String) -> Json {
  let path = path_text(@fs.realpath(path))
  let bytes = @fs.read_file(path).binary()
  { "path": path, "sha256": digest(bytes) }
}

///|
async fn package_metadata(
  directory : String,
  relative : String,
  output : String,
  entries : Array[Json],
) -> Unit {
  let path = if relative == "" { directory } else { directory + "/" + relative }
  for name in @fs.readdir(path) {
    let child_relative = if relative == "" {
      name
    } else {
      relative + "/" + name
    }
    let child = directory + "/" + child_relative
    if @fs.kind(child, follow_symlink=false) is Directory {
      package_metadata(directory, child_relative, output, entries)
    } else {
      let metadata = name == "setup.xz" ||
        name == "setup.ini" ||
        name == "setup.bz2" ||
        name.has_suffix(".sig")
      let runtime_archive = name.has_prefix("cygwin-") &&
        (
          name.has_suffix(".tar.xz") ||
          name.has_suffix(".tar.zst") ||
          name.has_suffix(".tar.bz2")
        )
      if metadata || runtime_archive {
        let bytes = @fs.read_file(child).binary()
        let retained = if metadata {
          let retained = "observations/package-metadata-" +
            entries.length().to_string() +
            ".bin"
          @fs.write_file(output + "/" + retained, bytes, create_mode=CreateNew)
          retained
        } else {
          "digest-only-package-archive"
        }
        entries.push({
          "cache_relative_path": child_relative,
          "sha256": digest(bytes),
          "length": bytes.length(),
          "retained": retained,
        })
      }
    }
  }
}

///|
async fn retain_installer_evidence(root : String, output : String) -> Unit {
  let entries : Array[Json] = []
  if @env.get_env_var("ORACLE_SETUP_EXE") is Some(path) && path != "" {
    entries.push({ "kind": "setup-executable", "artifact": artifact(path) })
  }
  let installed = root + "/etc/setup/installed.db"
  if @fs.exists(installed) {
    let bytes = @fs.read_file(installed).binary()
    let retained = "observations/installed.db"
    @fs.write_file(output + "/" + retained, bytes, create_mode=CreateNew)
    entries.push({
      "kind": "installed-packages",
      "path": installed,
      "sha256": digest(bytes),
      "length": bytes.length(),
      "retained": retained,
    })
  }
  if @env.get_env_var("ORACLE_PACKAGE_CACHE") is Some(path) && path != "" {
    require(@fs.exists(path), "action package-cache output does not exist")
    package_metadata(path_text(@fs.realpath(path)), "", output, entries)
  }
  save_json(output + "/installer-evidence.json", {
    "schema_version": 1,
    "entries": @json.to_json(entries),
  })
}

///|
async fn locate_tool(name : String) -> String {
  let path = @env.get_env_var("PATH").unwrap_or("")
  for directory in path.split(";") {
    let candidate = path_text(directory.to_owned()) + "/" + name
    if @fs.exists(candidate) {
      return path_text(@fs.realpath(candidate))
    }
  }
  fail("required observation tool is absent: " + name)
}

///|
async fn probe(
  output : String,
  name : String,
  program : String,
  argv : Array[String],
  cwd : String,
  environment : Map[String, String],
  deadline~ : Int32 = 30000,
) -> Probe {
  println("ci_oracle: starting " + name)
  let stdout_path = "observations/" + name + ".stdout.bin"
  let stderr_path = "observations/" + name + ".stderr.bin"
  let start_unix_ms = @env.now()
  let start = @async.now()
  let mut code : Int32? = None
  let mut status = "completed"
  let mut reason : String? = None
  try {
    code = @async.with_timeout_opt(deadline, () => {
      @process.run(
        program,
        argv,
        cwd~,
        extra_env=environment,
        inherit_env=false,
        stdin=@process.redirect_from_file(output + "/empty.bin"),
        stdout=@process.redirect_to_file(
          output + "/" + stdout_path,
          create_mode=CreateNew,
        ),
        stderr=@process.redirect_to_file(
          output + "/" + stderr_path,
          create_mode=CreateNew,
        ),
        cancel_handler=@process.hard_cancel(),
      )
    })
    if code is None {
      status = "timeout"
      reason = Some(
        "observation process exceeded its deadline; hard cancellation requested",
      )
    }
  } catch {
    error => {
      status = "error"
      reason = Some(error.to_string())
    }
  }
  for path in [stdout_path, stderr_path] {
    if !@fs.exists(output + "/" + path) {
      @fs.write_file(output + "/" + path, b"", create_mode=CreateNew)
    }
  }
  let stdout = @fs.read_file(output + "/" + stdout_path).binary()
  let stderr = @fs.read_file(output + "/" + stderr_path).binary()
  let result : Probe = {
    program,
    argv,
    cwd,
    status,
    exit_code: code,
    reason,
    stdout_path,
    stdout_sha256: digest(stdout),
    stdout_length: stdout.length(),
    stderr_path,
    stderr_sha256: digest(stderr),
    stderr_length: stderr.length(),
    start_unix_ms,
    elapsed_ms: @async.now() - start,
    deadline_ms: deadline,
  }
  save_json(output + "/observations/" + name + ".json", @json.to_json(result))
  result
}

///|
async fn successful_text(output : String, result : Probe) -> String {
  require(
    result.status == "completed" && result.exit_code == Some(0),
    "required observation failed: " + result.stdout_path,
  )
  trimmed(
    @utf8.decode(@fs.read_file(output + "/" + result.stdout_path).binary()),
  )
}

///|
fn drive_prefix(observed : String) -> String raise {
  let path = observed.trim_end(chars="/").to_owned()
  require(
    path.has_suffix("/c"),
    "unexpected official C-drive prefix: " + observed,
  )
  let prefix = path[:path.length() - 2].to_owned()
  if prefix == "" {
    "/"
  } else {
    prefix
  }
}

///|
fn drive_mount(posix : String, prefix : String) -> Bool {
  let head = if prefix == "/" { "/" } else { prefix + "/" }
  if posix.has_prefix(head) {
    let suffix = posix[head.length():]
    suffix.length() == 1 && suffix[0] >= 'a' && suffix[0] <= 'z'
  } else {
    false
  }
}

///|
fn mounted_context(raw : String, prefix : String) -> Array[Json] {
  let mounts : Array[Json] = []
  let seen : Map[String, Bool] = Map([])
  for line in raw.split("\n") {
    let sides = line.split(" on ").to_array()
    if sides.length() == 2 {
      let tail = sides[1].split(" type ").to_array()
      if tail.length() == 2 {
        let posix = trimmed(tail[0].to_owned())
        let windows = path_text(trimmed(sides[0].to_owned()))
        let ordinary = posix.has_prefix("/") &&
          (
            !posix.has_prefix("/dev/") ||
            posix == "/dev/shm" ||
            posix.has_prefix("/dev/shm/") ||
            posix == "/dev/mqueue" ||
            posix.has_prefix("/dev/mqueue/")
          ) &&
          posix != "/proc" &&
          !posix.has_prefix("/proc/") &&
          !drive_mount(posix, prefix)
        if ordinary &&
          windows.length() >= 3 &&
          windows[1] == ':' &&
          !seen.contains(posix) {
          mounts.push({
            "posix": posix,
            "windows": windows,
            "case_policy": if tail[1].contains("posix=0") {
              "windows-insensitive"
            } else {
              "sensitive"
            },
          })
          seen[posix] = true
        }
      }
    }
  }
  mounts
}

///|
fn observation_signature(observation : Json) -> String raise {
  text_field(field(observation, "stdout"), "sha256") +
  ":" +
  int_field(field(observation, "stdout"), "length").to_string() +
  ":" +
  text_field(field(observation, "stderr"), "sha256") +
  ":" +
  int_field(field(observation, "stderr"), "length").to_string() +
  ":" +
  int_field(observation, "exit_code").to_string()
}

///|
async fn verify_blob(directory : String, blob : Json) -> Bytes {
  let path = text_field(blob, "path")
  require(
    path != "" &&
    !path.contains(":") &&
    !path.contains("\\") &&
    path.split("/").all(part => part != "" && part != "." && part != ".."),
    "unsafe run-relative evidence path",
  )
  let bytes = @fs.read_file(directory + "/" + path).binary()
  require(
    bytes.length() == int_field(blob, "length") &&
    digest(bytes) == text_field(blob, "sha256"),
    "oracle evidence byte length/hash differs from recorded reference",
  )
  bytes
}

///|
async fn validate_run(
  directory : String,
  profile : String,
  suite : String,
  mode : String,
  backend : String,
  manifest_path : String,
  fixture_path : String,
  collector_exit : Int32?,
  signatures : Map[String, String],
  results : Array[GateCase],
) -> Bool {
  let run = @json.parse(@fs.read_file(directory + "/run.json").text())
  require(
    int_field(run, "schema_version") == 1 &&
    text_field(run, "profile") == profile &&
    text_field(run, "mode") == mode &&
    text_field(run, "validation_kind") == "official-comparison",
    "unexpected oracle run schema/identity",
  )
  let fixture_bytes = verify_blob(directory, field(run, "fixtures"))
  require(
    digest(fixture_bytes) == digest(@fs.read_file(fixture_path).binary()),
    "oracle run fixture differs from requested immutable input",
  )
  let fixture = @json.parse(@utf8.decode(fixture_bytes))
  let expected_cases : Array[Json] = @json.from_json(field(fixture, "cases"))
  let expected_ids : Map[String, Json] = Map([])
  for fixture_case in expected_cases {
    let id = text_field(fixture_case, "case_id")
    require(!expected_ids.contains(id), "duplicate fixture case_id")
    expected_ids[id] = fixture_case
  }
  let manifest_bytes = verify_blob(directory, field(run, "manifest"))
  require(
    manifest_bytes == @fs.read_file(manifest_path).binary(),
    "oracle run manifest differs from the exact requested immutable manifest",
  )
  let manifest = @json.parse(@utf8.decode(manifest_bytes))
  require(
    text_field(field(manifest, "project"), "backend") == backend,
    "wrong backend in oracle manifest",
  )
  require(
    bool_field(run, "complete") && bool_field(run, "integrity_verified"),
    "oracle run is incomplete or unverified: " + directory,
  )
  let cases : Array[Json] = @json.from_json(field(run, "cases"))
  require(
    cases.length() == expected_cases.length() &&
    cases.length() == int_field(run, "planned") &&
    int_field(run, "executed") == cases.length(),
    "oracle run skipped or omitted planned cases: " + directory,
  )
  let all_raw_pass = cases.all(result => text_field(result, "status") == "pass")
  require(
    collector_exit == Some(if all_raw_pass { 0 } else { 1 }),
    "collector exit does not match its completed raw comparison outcomes",
  )
  let seen : Map[String, Bool] = Map([])
  let mut accepted = true
  for result in cases {
    let case_id = text_field(result, "case_id")
    require(
      expected_ids.contains(case_id) && !seen.contains(case_id),
      "unexpected or duplicate oracle result case_id",
    )
    seen[case_id] = true
    let fixture_case = expected_ids.get(case_id).unwrap()
    let domain : String = optional_field(fixture_case, "validation_domain")
      .map(value => @json.from_json(value))
      .unwrap_or("supported")
    let raw_status = text_field(result, "status")
    let oracle = optional_field(result, "oracle")
    let project = optional_field(result, "project")
    let mut gate_status = raw_status
    let mut reason : String? = None
    for observation in [oracle, project] {
      if observation is Some(observation) {
        for key in ["stdin", "stdout", "stderr"] {
          ignore(verify_blob(directory, field(observation, key)))
        }
      }
    }
    if oracle is Some(oracle) &&
      project is Some(project) &&
      text_field(oracle, "execution_status") == "completed" &&
      text_field(project, "execution_status") == "completed" {
      // Independently recheck raw equality and backend/replay consistency.
      let oracle_signature = observation_signature(oracle)
      let project_signature = observation_signature(project)
      require(
        (raw_status == "pass") == (oracle_signature == project_signature),
        "run comparison status disagrees with raw evidence",
      )
      for
        (role, signature) in [
          ("oracle", oracle_signature),
          ("project", project_signature),
        ] {
        if (
            domain == "malformed-utf8" || domain == "unavailable-codepage-29001"
          ) &&
          role == "oracle" {
          continue
        }
        let key = suite + "/" + case_id + "/" + role
        match signatures.get(key) {
          Some(prior) if prior != signature => {
            gate_status = "inconsistent"
            reason = Some("backend or replay changed " + role + " bytes/status")
            accepted = false
          }
          None => signatures[key] = signature
          _ => ()
        }
      }
      if raw_status == "fail" &&
        gate_status != "inconsistent" &&
        domain == "supported" {
        reason = Some(
          "exact official equality is required; no difference exemptions are applied",
        )
        accepted = false
      }
      if (domain == "malformed-utf8" || domain == "unavailable-codepage-29001") &&
        gate_status != "inconsistent" {
        let prefix = text_field(field(manifest, "context"), "drive_prefix")
        let drive_c = prefix.trim_end(chars="/").to_owned() + "/c"
        let expected_stdout = text_field(fixture_case, "boundary_stdout").replace_all(
          old="{drive_c}",
          new=drive_c,
        )
        let expected_stderr = text_field(fixture_case, "boundary_stderr")
        if text_field(field(project, "stdout"), "sha256") ==
          digest(@utf8.encode(expected_stdout)) &&
          text_field(field(project, "stderr"), "sha256") ==
          digest(@utf8.encode(expected_stderr)) &&
          int_field(project, "exit_code") ==
          int_field(fixture_case, "boundary_exit") {
          if domain == "malformed-utf8" {
            gate_status = "input-domain-boundary"
            reason = Some(
              "Unix-output wide conversion has no defined result for this record; raw oracle observation retained and project rejection verified independently",
            )
          } else {
            gate_status = "capability-boundary"
            reason = Some(
              "CP29001 Windows API failure is independently measured; upstream ignores the failed conversion and has no defined output; raw observation retained and exact project rejection verified",
            )
          }
        } else {
          gate_status = "boundary-contract-fail"
          reason = Some("strict unsupported-input rejection contract failed")
        }
      }
    } else {
      accepted = false
      reason = Some(
        "both actual processes must complete before a comparison can be accepted",
      )
    }
    if gate_status != "pass" &&
      gate_status != "input-domain-boundary" &&
      gate_status != "capability-boundary" {
      accepted = false
    }
    results.push({
      profile,
      suite,
      mode,
      backend,
      case_id,
      validation_domain: domain,
      raw_status,
      gate_status,
      reason,
      oracle_stdout_sha256: oracle.map(value => {
        text_field(field(value, "stdout"), "sha256")
      }),
      oracle_stderr_sha256: oracle.map(value => {
        text_field(field(value, "stderr"), "sha256")
      }),
      oracle_exit_code: oracle.map(value => int_field(value, "exit_code")),
      project_stdout_sha256: project.map(value => {
        text_field(field(value, "stdout"), "sha256")
      }),
      project_stderr_sha256: project.map(value => {
        text_field(field(value, "stderr"), "sha256")
      }),
      project_exit_code: project.map(value => int_field(value, "exit_code")),
    })
  }
  accepted
}

///|
fn parse_options(args : ArrayView[String]) -> Map[String, String] raise {
  let options : Map[String, String] = Map([])
  let valid = [
    "--profile", "--root", "--wasm", "--moon", "--moonrun", "--out", "--source-revision",
    "--context-variant",
  ]
  for index = 0; index < args.length(); {
    let name = args[index]
    require(
      valid.contains(name) && index + 1 < args.length(),
      "invalid/missing CI oracle option: " + name,
    )
    require(!options.contains(name), "duplicate option: " + name)
    options[name] = args[index + 1]
    continue index + 2
  }
  for name in valid[:6] {
    require(options.contains(name), "required option absent: " + name)
  }
  options
}

///|
async fn audit_scope(
  repository : String,
  output : String,
  profile : String,
  variant : String,
  results : Array[GateCase],
) -> Bool {
  let bytes = @fs.read_file(repository + "/testdata/oracle/p3-scope.json").binary()
  @fs.write_file(output + "/scope.json", bytes, create_mode=CreateNew)
  let scope = @json.parse(@utf8.decode(bytes))
  require(
    int_field(scope, "schema_version") == 1 &&
    text_field(scope, "validation_kind") == "p3-scope",
    "unexpected P3 scope schema",
  )
  let rows : Array[Json] = @json.from_json(field(scope, "rows"))
  let audit : Array[Json] = []
  let covered : Map[String, Bool] = Map([])
  let row_ids : Map[String, Bool] = Map([])
  let mut complete = true
  let excluded : Array[Json] = []
  let mut planned_cases = 0
  for row in rows {
    let id = text_field(row, "id")
    require(!row_ids.contains(id), "duplicate scope row")
    row_ids[id] = true
    let variants : Array[String] = optional_field(row, "variants")
      .map(value => @json.from_json(value))
      .unwrap_or(["default", "custom"])
    if !variants.contains(variant) {
      excluded.push({
        "id": id,
        "reason": "outside selected context variant",
        "variants": @json.to_json(variants),
      })
      continue
    }
    let cases : Array[Json] = @json.from_json(field(row, "cases"))
    require(!cases.is_empty(), "empty scope capability row")
    let evidence : Array[Json] = []
    for item in cases {
      let profiles : Array[String] = @json.from_json(field(item, "profiles"))
      if !profiles.contains(profile) {
        continue
      }
      let suite = text_field(item, "suite")
      planned_cases += 1
      let case_id = text_field(item, "case_id")
      require(
        !covered.contains(suite + "/" + case_id),
        "scope assigns the same case more than once for selected profile/context",
      )
      let domain = text_field(item, "validation_domain")
      let matching = results.filter(result => {
        result.suite == suite && result.case_id == case_id
      })
      let identities : Map[String, Bool] = Map([])
      let verified = matching.length() == 2 &&
        matching.all(result => {
          let key = result.mode + "/" + result.backend
          let unique = !identities.contains(key)
          identities[key] = true
          unique &&
          ["collect", "replay"].contains(result.mode) &&
          result.backend == "wasm" &&
          result.validation_domain == domain &&
          (if domain == "supported" {
            result.gate_status == "pass"
          } else {
            (
              domain == "malformed-utf8" &&
              result.gate_status == "input-domain-boundary"
            ) ||
            (
              domain == "unavailable-codepage-29001" &&
              result.gate_status == "capability-boundary"
            )
          })
        })
      if !verified {
        complete = false
      }
      covered[suite + "/" + case_id] = true
      evidence.push({
        "suite": suite,
        "case_id": case_id,
        "validation_domain": domain,
        "verified": verified,
        "observations": @json.to_json(matching),
      })
    }
    audit.push({ "id": id, "evidence": @json.to_json(evidence) })
  }
  let unmapped = results.filter(result => {
    !covered.contains(result.suite + "/" + result.case_id)
  })
  if !unmapped.is_empty() {
    complete = false
  }
  save_json(output + "/coverage-audit.json", {
    "schema_version": 1,
    "profile": profile,
    "context_variant": variant,
    "planned_cases": planned_cases,
    "planned_comparisons": planned_cases * 2,
    "out_of_variant_rows": @json.to_json(excluded),
    "scope_sha256": digest(bytes),
    "complete": complete,
    "rows": @json.to_json(audit),
    "unmapped_observations": @json.to_json(unmapped),
  })
  complete
}

///|
async fn check_mount_owners(
  output : String,
  profile : String,
  bin : String,
  wasm : String,
  moonrun : String,
  cwd : String,
  environment : Map[String, String],
  compare : (Bool, String) -> Unit,
) -> Unit {
  let tmp = @fs.tmpdir(prefix="cygpath-owners-")
  defer @fs.rmdir(tmp, recursive=true)
  let base = path_text(@fs.realpath(tmp))
  let root = base + "/install"
  let user_dir = base + "/long-user-path"
  let sys_dir = base + "/s"
  let (runtime_bin, dll) = if profile == "cygwin" {
    (root + "/bin", "cygwin1.dll")
  } else {
    (root + "/usr/bin", "msys-2.0.dll")
  }
  for
    dir in [
      runtime_bin,
      root + "/etc",
      user_dir + "/child",
      sys_dir + "/child",
      base + "/normalized",
    ] {
    @fs.mkdir(dir, recursive=true)
  }
  for file in [dll, "cygpath.exe"] {
    @fs.write_file(
      runtime_bin + "/" + file,
      @fs.read_file(bin + "/" + file),
      create_mode=CreateNew,
    )
  }
  for dir in [user_dir, sys_dir] {
    @fs.write_file(dir + "/child/file", b"sample", create_mode=CreateNew)
  }
  @fs.write_file(base + "/normalized/leaf", b"sample", create_mode=CreateNew)
  let escaped = base.replace_all(old=" ", new="\\040")
  let fstab = user_dir.replace_all(old=" ", new="\\040") +
    " /dual ntfs user,text\n" +
    sys_dir.replace_all(old=" ", new="\\040") +
    " /dual ntfs binary,posix=0\n" +
    "/dual/child /copied none bind\n" +
    escaped +
    "/physical-alias /cygdrive/c/owner-probe ntfs text\n" +
    "relative /invalid ntfs binary\n" +
    escaped +
    "/normalized /etc/fstab/../skipped-file ntfs binary\n" +
    escaped +
    "/normalized /missing/../skipped-missing ntfs binary\n" +
    escaped +
    "/ghost/../normalized /etc/../picked ntfs binary\n"
  @fs.write_file(root + "/etc/fstab", fstab)
  @fs.write_file(output + "/mount-owners.fstab", fstab)
  let records = root + "/etc/records"
  @fs.write_file(
    records,
    "-m /dual/file\n-m /DUAL/file\n-u " +
    user_dir +
    "/file\n-u " +
    sys_dir +
    "/file\n-m /copied/file\n-M /copied/file\n-m /cygdrive/c/owner-probe/file\n-u " +
    base +
    "/physical-alias/file\n-m /picked/leaf\n-m /skipped-file/leaf\n-m /skipped-missing/leaf\n-u " +
    base +
    "/normalized/leaf\n",
  )
  let (winner, mode) = if profile == "cygwin" {
    (user_dir, "text")
  } else {
    (sys_dir, "binary")
  }
  let expected = [
      winner + "/file",
      sys_dir + "/file",
      "/dual/file",
      "/dual/file",
      winner + "/child/file",
      "/copied/file: " + mode,
      "C:/owner-probe/file",
      "/cygdrive/c/owner-probe/file",
      base + "/normalized/leaf",
      root + "/skipped-file/leaf",
      root + "/skipped-missing/leaf",
      "/picked/leaf",
    ].join("\n") +
    "\n"
  let installed = environment.copy()
  installed["CYGPATH_ROOT"] = root
  let reference = probe(
    output,
    "mount-owners-oracle",
    runtime_bin + "/cygpath.exe",
    ["-of", records],
    cwd,
    environment,
  )
  let project = probe(
    output,
    "mount-owners-wasm",
    moonrun,
    [wasm, "--", "--profile", profile, "-of", records],
    cwd,
    installed,
  )
  compare(
    reference.status == "completed" &&
    reference.exit_code == Some(0) &&
    reference.stderr_length == 0 &&
    reference.stdout_sha256 == digest(@utf8.encode(expected)) &&
    project.status == "completed" &&
    project.exit_code == reference.exit_code &&
    project.stdout_sha256 == reference.stdout_sha256 &&
    project.stderr_sha256 == reference.stderr_sha256,
    "isolated fstab conversion differs in " + profile,
  )
  let temp_table = "none /temporary usertemp binary\n"
  @fs.write_file(root + "/etc/fstab", temp_table)
  @fs.write_file(output + "/usertemp.fstab", temp_table)
  let temp_cases = [
    ("relative", "..\\missing", base + "/missing"),
    ("drive", root[:2].to_owned(), root),
    (
      "current-root",
      "\\cygpath-temp-probe",
      root[:2].to_owned() + "/cygpath-temp-probe",
    ),
    ("absolute", base + "/absent/../new", base + "/new"),
  ]
  // probe() starts the child with only the supplied environment, so there
  // is no saved current directory on an alternate drive.
  for drive in ["C:", "D:"] {
    if !root[:2].equal_ignore_ascii_case(drive) && @fs.exists(drive + "/") {
      temp_cases.push(
        (
          "other-drive",
          drive + "cygpath-temp-probe",
          drive + "/cygpath-temp-probe",
        ),
      )
      break
    }
  }
  for (name, value, expected) in temp_cases {
    let vars = environment.copy()
    vars["TMP"] = value
    let argv = ["-am", "/temporary/file"]
    let oracle = probe(
      output,
      "usertemp-" + name + "-oracle",
      runtime_bin + "/cygpath.exe",
      argv,
      root,
      vars,
    )
    vars["CYGPATH_ROOT"] = root
    let port = probe(
      output,
      "usertemp-" + name + "-wasm",
      moonrun,
      [wasm, "--", "--profile", profile, ..argv],
      root,
      vars,
    )
    compare(
      oracle.status == "completed" &&
      oracle.exit_code == Some(0) &&
      oracle.stderr_length == 0 &&
      oracle.stdout_sha256 == digest(@utf8.encode(expected + "/file\n")) &&
      port.status == "completed" &&
      port.exit_code == oracle.exit_code &&
      port.stdout_sha256 == oracle.stdout_sha256 &&
      port.stderr_sha256 == oracle.stderr_sha256,
      "usertemp " + name + " differs in " + profile,
    )
  }
}

///|
async fn check_installed_bind(
  output : String,
  bin : String,
  wasm : String,
  moonrun : String,
  cwd : String,
  environment : Map[String, String],
  compare : (Bool, String) -> Unit,
) -> Unit {
  let tmp = @fs.tmpdir(prefix="cygpath-bind-")
  defer @fs.rmdir(tmp, recursive=true)
  let root = path_text(@fs.realpath(tmp))
  for
    subdir in [
      "/bin", "/etc", "/physical", "/physical/data", "/target", "/work", "/devfiles",
      "/shadow",
    ] {
    @fs.mkdir(root + subdir)
  }
  for name in ["cygwin1.dll", "cygpath.exe"] {
    @fs.write_file(
      root + "/bin/" + name,
      @fs.read_file(bin + "/" + name),
      create_mode=CreateNew,
    )
  }
  @fs.write_file(
    root + "/cygdrive",
    "physical-name-must-not-be-read\n",
    create_mode=CreateNew,
  )
  let fstab = "/source/data /early none bind\n" +
    root.replace_all(old=" ", new="\\040") +
    "/physical /source ntfs posix=0,text\n" +
    "/SOURCE/data /alias none bind\n/ALIAS/nested /chain none bind\n" +
    root.replace_all(old=" ", new="\\040") +
    "/target /text-target ntfs text\n" +
    root.replace_all(old=" ", new="\\040") +
    "/WORK /fold-work ntfs posix=0\n" +
    root.replace_all(old=" ", new="\\040") +
    "/é /filename-\uF0FF ntfs binary\n" +
    "//localhost/cygpath-oracle-share /net-share ntfs binary\n" +
    root.replace_all(old=" ", new="\\040") +
    "/devfiles /dev/local ntfs text\n" +
    root.replace_all(old=" ", new="\\040") +
    "/shadow /dev/tty ntfs text\n" +
    "/dev/tty /ignored-device none bind\n/dev/tty/sub /bound-device-child none bind\n"
  @fs.write_file(root + "/etc/fstab", fstab)
  @fs.write_file(output + "/bind-fstab.txt", fstab)
  save_json(output + "/bind-installation.json", {
    "root": root,
    "official": artifact(root + "/bin/cygpath.exe"),
    "runtime": artifact(root + "/bin/cygwin1.dll"),
    "wasm": artifact(wasm),
    "launcher": artifact(moonrun),
    "fstab_sha256": digest(@utf8.encode(fstab)),
  })
  let installed = environment.copy()
  installed["CYGPATH_ROOT"] = root
  @fs.write_file(root + "/physical/data/known", b"abc")
  @fs.write_file(root + "/devfiles/names", b"C:/file\n")
  @fs.symlink(root + "/bin/mode-link", target=root + "/target")
  @fs.write_file(root + "/target/known", b"child")
  @fs.symlink(root + "/bin/CaseLink", target=root + "/target/known")
  @fs.write_file(root + "/bin/exact", b"plain")
  let shortcut_setup = probe(
    output,
    "explorer-shortcut-setup",
    locate_tool("pwsh.exe"),
    [
      "-NoProfile",
      "-NonInteractive",
      "-Command",
      (
        #|$ErrorActionPreference='Stop'
        #|$path = [IO.Path]::Combine((Get-Location).Path, 'Explorer.lnk')
        #|$shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut($path)
        #|$shortcut.TargetPath = (Get-Item -LiteralPath 'exact').FullName
        #|$shortcut.Description = 'ordinary Windows shell link'
        #|$shortcut.Save()
        #|[Console]::WriteLine([Convert]::ToHexString([IO.File]::ReadAllBytes($path)[0..75]))
      ),
    ],
    root + "/bin",
    environment,
  )
  ignore(successful_text(output, shortcut_setup))
  @fs.write_file(root + "/bin/exact.exe", b"suffix")
  @fs.write_file(root + "/bin/tool.conf.exe", b"suffix")
  @fs.write_file(root + "/bin/names.lst.exe", b"C:/one\r\nC:/two\n")
  @fs.symlink(root + "/bin/list-link", target=root + "/bin/names.lst.exe")
  @fs.mkdir(root + "/bin/dir-only.exe")
  @fs.write_file(root + "/work/tool.conf.exe", b"suffix")
  @fs.mkdir(root + "/work/dir-only.exe")
  let parent = "a".repeat(125) + "/" + "b".repeat(125)
  @fs.mkdir(root + "/bin/" + "a".repeat(125))
  let long_parent = "\\\\?\\" +
    (root + "/bin/" + parent).replace_all(old="/", new="\\")
  @fs.mkdir(long_parent)
  for name in ["abc.exe", "abcd.exe"] {
    @fs.write_file(long_parent + "\\" + name, b"suffix")
  }
  @fs.symlink(long_parent + "\\longlink", target=root + "/target/known")
  let long_dir = "Directory for long names"
  let long_file = long_dir + "\\Document with spaces.txt"
  let hard_link = long_dir + "\\Second hard link.txt"
  @fs.mkdir(root + "/bin/" + long_dir)
  @fs.write_file(root + "/bin/" + path_text(long_file), b"long name")
  let hard_setup = probe(
    output,
    "long-hardlink-setup",
    locate_tool("pwsh.exe"),
    [
      "-NoProfile", "-NonInteractive", "-Command", "$ErrorActionPreference='Stop'; New-Item -ItemType HardLink -Path 'Directory for long names/Second hard link.txt' -Target (Get-Item -LiteralPath 'Directory for long names/Document with spaces.txt').FullName | Out-Null",
    ],
    root + "/bin",
    environment,
  )
  ignore(successful_text(output, hard_setup))
  async fn short_spelling(label : String, name : String) -> String {
    successful_text(
      output,
      probe(
        output,
        "long-" + label + "-short-name",
        root + "/bin/cygpath.exe",
        ["-ws", name],
        root + "/bin",
        environment,
      ),
    )
  }
  let short_file = short_spelling("file", long_file)
  let short_hard_link = short_spelling("hardlink", hard_link)
  save_json(output + "/long-name-fixture.json", {
    "file": long_file,
    "short_file": short_file,
    "hard_link": hard_link,
    "short_hard_link": short_hard_link,
    "observed_distinct_file_alias": short_file != long_file,
    "observed_distinct_hardlink_alias": short_hard_link != hard_link,
  })
  @fs.write_file(root + "/bin/Case.TXT", b"case")
  let short_parent = short_file.rev_split_once("\\").unwrap().0.to_owned()
  let missing = short_parent + "\\absent.txt"
  let records = root + "/etc/mode-records"
  @fs.write_file(root + "/etc/parent-records", b"/usr/bin/cygpath.exe\n")
  for
    (label, args, stdout, stderr, code) in [
      (
        "explorer-shortcut",
        ["-m", "/bin/Explorer.lnk", "/bin/Explorer"],
        root + "/bin/Explorer.lnk\n" + root + "/bin/Explorer\n",
        "",
        0,
      ),
      (
        "implicit-explorer-shortcut-input",
        ["-uf", "/bin/Explorer"],
        "",
        "cygpath: No such file or directory\n",
        1,
      ),
      (
        "physical-dev-input",
        ["-uf", "/dev/local/names"],
        "/cygdrive/c/file\n",
        "",
        0,
      ),
      (
        "reverse-device-mount",
        ["-u", root + "/shadow/file"],
        "/dev/tty/file\n",
        "",
        0,
      ),
      (
        "filename-utf8-mount",
        ["-u", root + "/\uF0C3\uF0A9/tail"],
        "/filename-\uF0FF/tail\n",
        "",
        0,
      ),
      (
        "invalid-nt-drive-relative",
        ["-u", "\\??\\C:name"],
        "",
        "cygpath: error converting \"\\??\\C:name\" - Invalid argument\n",
        1,
      ),
      (
        "invalid-list-drive-relative",
        ["-pu", "C:/ok;\\\\?\\C:name"],
        "",
        "cygpath: error converting \"C:/ok;\\\\?\\C:name\" - Unknown error -1\n",
        1,
      ),
      (
        "network-mount-traversal",
        [
          "-u", "//localhost/other/../cygpath-oracle-share/file", "//localhost//cygpath-oracle-share/sub/.",
          "//localhost/cygpath-oracle-share/.",
        ],
        "/net-share/file\n/net-share/sub/\n/net-share\n",
        "",
        0,
      ),
      ("dos-dot", ["-d", "."], ".\n", "", 0),
      (
        "dos-existing-drive-root",
        ["-d", root[:3].to_owned()],
        root[:2].to_owned() + "\\\n",
        "",
        0,
      ),
      (
        "dos-missing",
        ["-ws", "absent83.txt"],
        "",
        "cygpath: cannot create short name of absent83.txt\n",
        2,
      ),
      (
        "dos-missing-list",
        ["-msp", ".:absent83.txt:later"],
        "",
        "cygpath: cannot create short name of absent83.txt\n",
        2,
      ),
      (
        "dos-stream-prefix",
        ["-tdos", ".", "absent83.txt"],
        ".\n",
        "cygpath: cannot create short name of absent83.txt\n",
        2,
      ),
      ("long-observed-alias", ["-wl", short_file], long_file + "\n", "", 0),
      ("long-hardlink-alias", ["-wl", short_hard_link], hard_link + "\n", "", 0),
      ("long-missing", ["-wl", missing], missing + "\n", "", 0),
      ("long-short-case", ["-wl", "cASE.txt"], "Case.TXT\n", "", 0),
      ("long-link-case", ["-wl", "cASElINK"], "CaseLink\n", "", 0),
      (
        "long-preserves-case",
        ["-wl", long_dir + "\\document WITH spaces.txt"],
        long_dir + "\\document WITH spaces.txt\n",
        "",
        0,
      ),
      (
        "long-list",
        ["-mlp", short_file + ":" + missing],
        path_text(long_file) + ";" + path_text(missing) + "\n",
        "",
        0,
      ),
      (
        "long-link-child",
        ["-ml", "mode-link/known"],
        "mode-link/known\n",
        "",
        0,
      ),
      (
        "executable",
        ["-m", "/usr/bin/cygpath"],
        root + "/bin/cygpath.exe\n",
        "",
        0,
      ),
      ("relative-executable", ["-w", "cygpath"], "cygpath.exe\n", "", 0),
      (
        "cwd-fold-suffix",
        ["-m", "../fold-work/tool.conf"],
        "tool.conf.exe\n",
        "",
        0,
      ),
      (
        "cwd-fold-directory",
        ["-w", "../fold-work/dir-only.exe/"],
        "dir-only.exe\\\n",
        "",
        0,
      ),
      ("cwd-fold-self", ["-w", "../fold-work/."], ".\\\n", "", 0),
      (
        "cwd-fold-absolute",
        ["-am", "../fold-work/tool.conf"],
        root + "/WORK/tool.conf.exe\n",
        "",
        0,
      ),
      ("exact-name", ["-m", "/bin/exact"], root + "/bin/exact\n", "", 0),
      (
        "relative-259-suffix",
        ["-m", parent + "/abc"],
        parent + "/abc.exe\n",
        "",
        0,
      ),
      (
        "relative-260-suffix",
        ["-m", parent + "/abcd"],
        "//?/" + root + "/bin/" + parent + "/abcd\n",
        "",
        0,
      ),
      (
        "relative-260-explicit-absolute",
        ["-am", parent + "/abcd"],
        "//?/" + root + "/bin/" + parent + "/abcd.exe\n",
        "",
        0,
      ),
      (
        "relative-260-link",
        ["-m", parent + "/longlink"],
        root + "/target/known\n",
        "",
        0,
      ),
      ("drive-directory-input", ["-mf", "/proc/cygdrive"], "", "", 0),
      (
        "file-input-suffix",
        ["-uf", "/bin/names.lst"],
        "/cygdrive/c/one\n/cygdrive/c/two\n",
        "",
        0,
      ),
      (
        "file-input-relative-suffix",
        ["-uf", "names.lst"],
        "/cygdrive/c/one\n/cygdrive/c/two\n",
        "",
        0,
      ),
      (
        "file-input-link",
        ["-uf", "list-link"],
        "/cygdrive/c/one\n/cygdrive/c/two\n",
        "",
        0,
      ),
      ("file-input-exact", ["-wf", "exact"], "plain\n", "", 0),
      ("file-input-directory", ["-uf", "/bin/dir-only.exe"], "", "", 0),
      (
        "file-input-suffix-directory",
        ["-uf", "dir-only"],
        "",
        "cygpath: No such file or directory\n",
        1,
      ),
      (
        "file-input-suffix-trailing",
        ["-uf", "names.lst/"],
        "",
        "cygpath: Not a directory\n",
        1,
      ),
      (
        "proc-file-directory",
        ["-w", "/proc/version/"],
        "",
        "cygpath: error converting \"/proc/version/\" - Not a directory\n",
        1,
      ),
      (
        "proc-absent",
        ["-w", "/proc/cygpath-absent"],
        "",
        "cygpath: error converting \"/proc/cygpath-absent\" - No such file or directory\n",
        1,
      ),
      (
        "proc-file-child",
        ["-w", "/proc/version/child"],
        "",
        "cygpath: error converting \"/proc/version/child\" - No such file or directory\n",
        1,
      ),
      (
        "suffix-list",
        ["-mp", "/bin/tool.conf:/bin/dir-only"],
        root + "/bin/tool.conf.exe;" + root + "/bin/dir-only\n",
        "",
        0,
      ),
      ("link-leaf", ["-m", "/bin/mode-link"], root + "/bin/mode-link\n", "", 0),
      (
        "link-existing-child",
        ["-m", "/bin/mode-link/known"],
        root + "/bin/mode-link/known\n",
        "",
        0,
      ),
      (
        "link-missing-child",
        ["-m", "/bin/mode-link/missing"],
        root + "/target/missing\n",
        "",
        0,
      ),
      (
        "link",
        ["-m", "/bin/mode-link/../etc/parent-records"],
        root + "/etc/parent-records\n",
        "",
        0,
      ),
      (
        "relative",
        ["-m", "mode-link/../etc/missing"],
        root + "/etc/missing\n",
        "",
        0,
      ),
      (
        "list",
        ["-mp", "/bin/mode-link/../etc/first:/bin/cygpath.exe"],
        root + "/etc/first;" + root + "/bin/cygpath.exe\n",
        "",
        0,
      ),
      (
        "input",
        ["-m", "-f", "/bin/mode-link/../etc/parent-records"],
        root + "/bin/cygpath.exe\n",
        "",
        0,
      ),
      (
        "absent",
        ["-m", "/absent/../etc"],
        "",
        "cygpath: error converting \"/absent/../etc\" - No such file or directory\n",
        1,
      ),
      (
        "file",
        ["-m", "/bin/cygpath.exe/../etc"],
        "",
        "cygpath: error converting \"/bin/cygpath.exe/../etc\" - Not a directory\n",
        1,
      ),
    ] {
    let test_cwd = root +
      (if label.has_prefix("cwd-fold-") { "/work" } else { "/bin" })
    let official = probe(
      output,
      "parent-" + label + "-oracle",
      root + "/bin/cygpath.exe",
      args,
      test_cwd,
      environment,
    )
    let project = probe(
      output,
      "parent-" + label + "-wasm",
      moonrun,
      [wasm, "--", ..args],
      test_cwd,
      installed,
    )
    compare(
      official.status == "completed" &&
      official.exit_code == Some(code) &&
      official.stdout_sha256 == digest(@utf8.encode(stdout)) &&
      official.stderr_sha256 == digest(@utf8.encode(stderr)) &&
      project.status == "completed" &&
      project.exit_code == official.exit_code &&
      project.stdout_sha256 == official.stdout_sha256 &&
      project.stderr_sha256 == official.stderr_sha256,
      "installed Windows-output conversion differs: " + label,
    )
  }
  @fs.write_file(
    records, "-M /alias/known\n/bin/mode-link/missing\n\n/source/data/known/child\n/bin/cygpath.exe\n",
  )
  for
    (label, args, stdout, stderr) in [
      (
        "argv",
        ["-M", "/source/data/known", "/alias/missing", "/bin/cygpath.exe"],
        "/source/data/known: text\n/alias/missing: text\n/bin/cygpath.exe: binary\n",
        "",
      ),
      (
        "records",
        ["-o", "-f", records],
        "/alias/known: text\n/bin/mode-link/missing: text\n/bin/cygpath.exe: binary\n",
        "cygpath: file '' - No such file or directory\ncygpath: file '/source/data/known/child' - Not a directory\n",
      ),
    ] {
    let official = probe(
      output,
      "mode-" + label + "-oracle",
      root + "/bin/cygpath.exe",
      args,
      cwd,
      environment,
    )
    let project = probe(
      output,
      "mode-" + label + "-wasm",
      moonrun,
      [wasm, "--", ..args],
      cwd,
      installed,
    )
    compare(
      official.status == "completed" &&
      official.exit_code == Some(0) &&
      official.stdout_sha256 == digest(@utf8.encode(stdout)) &&
      official.stderr_sha256 == digest(@utf8.encode(stderr)) &&
      project.status == "completed" &&
      project.exit_code == official.exit_code &&
      project.stdout_sha256 == official.stdout_sha256 &&
      project.stderr_sha256 == official.stderr_sha256,
      "installed Cygwin file modes differ: " + label,
    )
  }
  for
    (name, path, suffix) in [
      ("origin", "/early/file", "/source/data/file"),
      ("case", "/ALIAS/file", "/physical/data/file"),
      ("chain", "/chain/file", "/physical/data/nested/file"),
      ("ignored-device", "/ignored-device", "/ignored-device"),
      ("bound-device-child", "/bound-device-child/file", "/shadow/sub/file"),
    ] {
    let args = ["-m", path]
    let official = probe(
      output,
      "bind-" + name + "-oracle",
      root + "/bin/cygpath.exe",
      args,
      cwd,
      environment,
    )
    let project = probe(
      output,
      "bind-" + name + "-wasm",
      moonrun,
      [wasm, "--", ..args],
      cwd,
      installed,
    )
    compare(
      successful_text(output, official) == root + suffix &&
      project.status == "completed" &&
      project.exit_code == official.exit_code &&
      project.stdout_sha256 == official.stdout_sha256 &&
      project.stderr_sha256 == official.stderr_sha256,
      "isolated Cygwin fstab bind differs: " + name,
    )
  }
}

///|
fn explicit_mount_args(
  wasm : String,
  profile : String,
  prefix : String,
  raw : String,
) -> Array[String] raise {
  let args = [wasm, "--", "--profile", profile, "--drive-prefix", prefix]
  for mount in mounted_context(raw, prefix) {
    let key = text_field(mount, "posix")
    args.append([
      "--mount",
      key,
      text_field(mount, "windows"),
      "--mount-case",
      key,
      text_field(mount, "case_policy"),
    ])
  }
  args
}

///|
async fn run(options : Map[String, String]) -> Unit {
  require(
    @async.platform is Windows,
    "CI official-oracle orchestration requires Windows",
  )
  let comparison_failures : Array[String] = []
  let mut extra_comparisons = 0
  fn compare(matched : Bool, description : String) -> Unit {
    extra_comparisons += 1
    if !matched {
      println("comparison failed: " + description)
      comparison_failures.push(description)
    }
  }
  let profile = options.get("--profile").unwrap()
  let variant = options.get("--context-variant").unwrap_or("default")
  require(
    variant == "default" || variant == "custom",
    "unknown context variant",
  )
  require(profile == "cygwin" || profile == "msys2", "unknown profile")
  let root = path_text(@fs.realpath(options.get("--root").unwrap()))
  let bin = root + (if profile == "cygwin" { "/bin" } else { "/usr/bin" })
  let cygpath = bin + "/cygpath.exe"
  let runtime = bin +
    (if profile == "cygwin" { "/cygwin1.dll" } else { "/msys-2.0.dll" })
  require(
    @fs.exists(cygpath) && @fs.exists(runtime),
    "selected installation lacks matching cygpath/runtime",
  )
  let moon = path_text(@fs.realpath(options.get("--moon").unwrap()))
  let moonrun = path_text(@fs.realpath(options.get("--moonrun").unwrap()))
  let wasm = path_text(@fs.realpath(options.get("--wasm").unwrap()))
  let repository = path_text(@fs.realpath("."))
  @fs.mkdir(options.get("--out").unwrap())
  let output = path_text(@fs.realpath(options.get("--out").unwrap()))
  @fs.mkdir(output + "/observations")
  @fs.write_file(output + "/empty.bin", b"", create_mode=CreateNew)
  retain_installer_evidence(root, output)
  let cwd = "C:/cygpath-ci/" + profile + "/cwd"
  @fs.mkdir(cwd, recursive=true, allow_exist=true)
  let environment : Map[String, String] = Map([])
  for
    name in [
      "WINDIR", "COMSPEC", "TEMP", "TMP", "USERPROFILE", "HOME", "HOMEDRIVE", "HOMEPATH",
      "MOON_HOME", "APPDATA", "LOCALAPPDATA", "SystemDrive", "ProgramFiles", "ProgramFiles(x86)",
      "ProgramW6432", "ProgramData", "PSModulePath", "PATHEXT", "OS", "PROCESSOR_ARCHITECTURE",
      "NUMBER_OF_PROCESSORS", "USERNAME", "USERDOMAIN",
    ] {
    if @env.get_env_var(name) is Some(value) {
      environment[name] = value
    }
  }
  environment["PATH"] = bin + ";" + @env.get_env_var("PATH").unwrap_or("")
  environment["LANG"] = "C.UTF-8"
  environment["LC_ALL"] = "C.UTF-8"
  environment["MSYS2_ARG_CONV_EXCL"] = "*"
  environment["MSYS2_ENV_CONV_EXCL"] = "*"
  environment["CYGWIN"] = "noglob"
  environment["MSYS"] = "noglob"
  let system_root = @env.get_env_var("SystemRoot").unwrap_or(
    @env.get_env_var("SYSTEMROOT").unwrap_or(""),
  )
  require(system_root != "", "Windows SystemRoot environment is absent")
  environment["SystemRoot"] = system_root
  save_json(output + "/environment.json", @json.to_json(environment))
  let powershell = locate_tool("pwsh.exe")
  let codepage_probe = probe(
    output,
    "windows-codepage-api",
    moon,
    [
      "run",
      "--deny-warn",
      repository + "/scripts/probe_windows_codepages.mbtx",
      output + "/codepage-api-probe",
      powershell,
    ],
    repository,
    environment,
    deadline=120000,
  )
  ignore(successful_text(output, codepage_probe))
  let codepage_result = @json.parse(
    @fs.read_file(output + "/codepage-api-probe/result.json").text(),
  )
  require(
    bool_field(codepage_result, "assertions_passed"),
    "CP29001 capability boundary requires successful independent Windows API diagnosis",
  )
  if variant == "default" {
    check_mount_owners(
      output, profile, bin, wasm, moonrun, cwd, environment, compare,
    )
    let installed = environment.copy()
    installed["CYGPATH_ROOT"] = root
    let cases : Array[(String, Array[String], Bytes, Bytes)] = [
      (
        "nt-null-mode",
        ["-M", "/dev/null", "/dev/zero", "/dev/null/"],
        b"/dev/null: binary\n/dev/zero: binary\n",
        b"cygpath: file '/dev/null/' - Not a directory\n",
      ),
      ("nt-null-input", ["-wf", "/dev/null"], b"", b""),
      (
        "nt-null-ibm037",
        ["-mC37", "/dev/null"],
        b"\xe0\xe0\x4b\xe0\xc7\xd3\xd6\xc2\xc1\xd3\xd9\xd6\xd6\xe3\xe0\xc4\x85\xa5\x89\x83\x85\xe0\xd5\xa4\x93\x93\n",
        b"",
      ),
      ("network-root-windows", ["-w", "//"], b"\\\\\n", b""),
      ("network-root-input", ["-wf", "//"], b"", b""),
      ("network-root-mode", ["-M", "//"], b"//: binary\n", b""),
      (
        "network-server-output",
        ["-wp", "//absent.invalid://tsclient/://wsl$"],
        b"\\\\absent.invalid;\\\\tsclient\\;\\\\wsl$\n",
        b"",
      ),
      (
        "network-server-absolute",
        ["-am", "//localhost/", "//localhost@SSL@443/.", "\\\\127.0.0.1\\"],
        b"//localhost\n//localhost@SSL@443\n//127.0.0.1\n",
        b"",
      ),
      (
        "network-server-mode",
        ["-M", "//localhost", "//absent.invalid/"],
        b"//localhost: binary\n//absent.invalid/: binary\n",
        b"",
      ),
      ("network-server-input", ["-wf", "//localhost/"], b"", b""),
      ("network-server-absent-input", ["-wf", "//absent.invalid/"], b"", b""),
      (
        "network-parent-windows",
        [
          "-m", "\\\\discard.invalid\\share\\..\\..\\localhost", "\\\\localhost\\data\\..",
          "\\\\discard.invalid\\..\\..",
        ],
        b"//localhost\n//localhost/\n//\n",
        b"",
      ),
      (
        "network-parent-posix",
        ["-m", "//127.0.0.1/../localhost", "//127.0.0.1/../..", "//../../.."],
        b"//localhost\n//\n//\n",
        b"",
      ),
      (
        "network-parent-mode",
        ["-M", "//127.0.0.1/.."],
        b"//127.0.0.1/..: binary\n",
        b"",
      ),
      ("network-parent-input", ["-wf", "//127.0.0.1/../localhost/"], b"", b""),
      (
        "leading-slashes",
        ["-mp", "//:////proc/version:////dev/tty"],
        b"//;/proc/version;/dev/tty\n",
        b"",
      ),
    ]
    let share = "//localhost/" + output[:1].to_owned() + "$"
    let directory = share + output[2:].to_owned()
    let accessible = output[1:].has_prefix(":/") &&
      (try
        @fs.read_file(directory + "/environment.json").binary() ==
        @fs.read_file(output + "/environment.json").binary()
      catch {
        _ => false
      })
    save_json(output + "/network-share-fixture.json", {
      "path": Json(directory),
      "accessible": Json(accessible),
    })
    if accessible {
      let operand = directory + "/observations/../empty.bin"
      cases.push(
        ("network-share-root", ["-m", share], @utf8.encode(share + "\n"), b""),
      )
      cases.push(
        (
          "network-share-parent-output",
          ["-m", operand],
          @utf8.encode(directory + "/empty.bin\n"),
          b"",
        ),
      )
      cases.push(("network-share-parent-input", ["-wf", operand], b"", b""))
      for
        (child, reason) in [
          ("empty.bin", "Not a directory"),
          ("absent-entry", "No such file or directory"),
        ] {
        let name = directory + "/" + child + "/.."
        cases.push(
          (
            "network-parent-mode-" + child,
            ["-M", name],
            b"",
            @utf8.encode("cygpath: file '" + name + "' - " + reason + "\n"),
          ),
        )
      }
    }
    for (name, args, stdout, stderr) in cases {
      let reference = probe(
        output,
        name + "-oracle",
        cygpath,
        args,
        cwd,
        environment,
      )
      compare(
        reference.status == "completed" &&
        reference.exit_code == Some(0) &&
        reference.stdout_sha256 == digest(stdout) &&
        reference.stderr_sha256 == digest(stderr),
        "unexpected official " + name + " in " + profile,
      )
      for
        (selection, env) in [
          ("implicit", environment),
          ("installed", installed),
        ] {
        let actual = probe(
          output,
          name + "-" + selection,
          moonrun,
          [wasm, "--", "--profile", profile, ..args],
          cwd,
          env,
        )
        compare(
          actual.status == "completed" &&
          actual.exit_code == reference.exit_code &&
          actual.stdout_sha256 == reference.stdout_sha256 &&
          actual.stderr_sha256 == reference.stderr_sha256,
          "Wasm " + name + " differs in " + selection + " " + profile,
        )
      }
    }
  }
  if profile == "msys2" && variant == "default" {
    let installed = environment.copy()
    installed["CYGPATH_ROOT"] = root
    for
      (name, args) in [
        ("bin", ["-m", "/bin"]),
        ("suffix", ["-w", "/bin/sh"]),
        (
          "local-leading-slashes",
          ["-m", "///bin/sh", "////usr/bin/../bin/sh.exe"],
        ),
        ("reverse", ["-u", root + "/usr/bin/cygpath.exe"]),
        ("drives", ["-u", "C:/"]),
        ("cwd", ["-au", "."]),
        ("mode", ["-M", "/bin/cygpath.exe"]),
      ] {
      let official = probe(
        output,
        "msys-install-" + name + "-oracle",
        cygpath,
        args,
        cwd,
        environment,
      )
      let project = probe(
        output,
        "msys-install-" + name + "-wasm",
        moonrun,
        [wasm, "--", "--profile=msys2", ..args],
        cwd,
        installed,
      )
      compare(
        official.status == "completed" &&
        official.exit_code == Some(0) &&
        official.stdout_length > 0 &&
        project.status == "completed" &&
        project.exit_code == official.exit_code &&
        project.stdout_sha256 == official.stdout_sha256 &&
        project.stderr_sha256 == official.stderr_sha256,
        "MSYS2 installation differs from cygpath: " + name,
      )
    }
  }
  if profile == "cygwin" && variant == "default" {
    check_installed_bind(output, bin, wasm, moonrun, cwd, environment, compare)
    let installed = environment.copy()
    installed["CYGPATH_ROOT"] = root
    // Keep the official device spellings and exit status for this session.
    for device in ["null", "console"] {
      ignore(
        probe(
          output,
          "device-" + device,
          cygpath,
          ["-w", "/dev/" + device],
          cwd,
          environment,
        ),
      )
    }
    // Keep the native API spellings as evidence. For POSIX output Cygwin
    // separately asks the filesystem for the directory's stored name.
    for option in ["-wW", "-wS", "-wF0x24", "-wF0x25"] {
      let raw = probe(
        output,
        "folder-raw" + option,
        cygpath,
        [option],
        cwd,
        environment,
      )
      let path = successful_text(output, raw)
      require(!path.is_empty(), "empty official Windows folder: " + option)
    }
    let input = output + "/installed-input.txt"
    @fs.write_file(
      input,
      b"/usr/bin/sh.exe\n/usr/lib/nonexistent\n",
      create_mode=CreateNew,
    )
    let input_path = successful_text(
      output,
      probe(
        output,
        "installed-input-path",
        cygpath,
        ["-u", input],
        cwd,
        environment,
      ),
    )
    @fs.write_file(
      input + ".folders",
      b"-wF1\n-F3\n-F4\n-F0xa\n-F0x11\n-F0x12\n-F0x31\n-F0x3d\n-wF0x403d\n-uF20\n-UF070\n-m /usr/bin/sh.exe\n",
      create_mode=CreateNew,
    )
    @fs.write_file(
      input + ".names",
      @utf8.encode("-u C:/\uF0FF\n-pu C:/\uF0C3\uF0A9;;C:/\uF080\n"),
      create_mode=CreateNew,
    )
    @fs.write_file(
      input + ".narrow",
      b"-w \xff\n-m /usr/bin/\x80\n-wp /usr/bin/\xff:/usr/lib/\xc3\xa9\n-wC1252 \xff\n",
      create_mode=CreateNew,
    )
    @fs.write_file(
      input + ".cesu-pairs",
      b"-m /usr/bin/\xed\xa0\xbd\xed\xb8\x80\n-u C:/\xed\xa0\xbd\xed\xb8\x80\n-pu C:/\xed\xa0\xbd\xed\xb8\x80;relative\n-wC1252 /usr/lib/\xed\xa0\xbd\xed\xb8\x80\n",
      create_mode=CreateNew,
    )
    let iscii_records = StringBuilder()
    for page in 57002..<=57011 {
      iscii_records.write_string(
        "-mC\{page} /cygdrive/c/कকAখ/அఅಒഅଅਅઅ/क्\u{200c}क्\u{200d}क/€😀॰\n",
      )
    }
    @fs.write_file(
      input + ".iscii",
      iscii_records.to_string(),
      create_mode=CreateNew,
    )
    // Keep the observations for isolated units independent of pair parity.
    @fs.write_file(
      input + ".utf16-units",
      b"/usr/bin/\xed\xa0\xbd\n/usr/bin/\xed\xb8\x80\n",
      create_mode=CreateNew,
    )
    let units = probe(
      output,
      "filename-utf16-units",
      cygpath,
      ["-wC65001", "-f", input_path + ".utf16-units"],
      cwd,
      environment,
    )
    require(
      units.status == "completed",
      "Windows UTF-16 filename observation did not finish",
    )
    for
      (name, args) in [
        ("root", ["-m", "/"]),
        ("filename-byte-ff", ["-u", "C:/\u{f0ff}"]),
        ("filename-byte-records", ["-of", input_path + ".names"]),
        ("filename-narrow-records", ["-of", input_path + ".narrow"]),
        ("filename-cesu-pairs", ["-of", input_path + ".cesu-pairs"]),
        ("filename-byte-pair", ["-u", "C:/\u{f0c3}\u{f0a9}"]),
        ("filename-split-surrogate", ["-u", "ab😀" + "x".repeat(255)]),
        (
          "filename-byte-list",
          ["-pu", root + "/bin/\u{f0ff};;C:/\u{f0c3}\u{f0a9}"],
        ),
        ("windows-folder", ["-W"]),
        ("system-folder-proc", ["-US"]),
        ("windows-folder-octal", ["-F044"]),
        ("system-folder-hex", ["--folder=0x25"]),
        ("folder-final-selector", ["-Fbad", "-AW"]),
        ("folder-records", ["-of", input_path + ".folders"]),
        ("physical-dev", ["-w", "/dev"]),
        (
          "physical-dev-names",
          ["-mp", "/dev/cygpath-local:/dev/ttyS128:/dev/sddx64"],
        ),
        ("proc-files", ["-w", "/proc/version", "/proc/uptime", "/proc/meminfo"]),
        (
          "proc-directories",
          [
            "-wp", "/proc/.:/proc/net/:/proc/sysvipc:/proc/registry64/hkey_current_user",
          ],
        ),
        ("proc-absolute", ["-aw", "/proc/net/..", "/proc/registry/"]),
        ("proc-mode", ["-M", "/proc/uptime", "/proc/cygpath-absent", "/proc"]),
        ("terminals", ["-w", "/dev/tty", "/dev/ptmx"]),
        ("terminal-list", ["-mp", "/dev/tty:/dev/ptmx"]),
        ("terminal-mode", ["-M", "/dev/tty", "/dev/ptmx", "/dev/tty/"]),
        ("terminal-mixed-ebcdic", ["-mC37", "/dev/tty"]),
        ("dev-ipc-directories", ["-mp", "/dev/shm:/dev/mqueue"]),
        ("bin", ["-w", "/usr/bin/sh.exe"]),
        ("bin-implicit-exe", ["-w", "/usr/bin/sh"]),
        ("lib", ["-m", "/usr/lib/new-file"]),
        ("reverse", ["-u", root + "/bin/sh.exe"]),
        ("drive-relative-keep", ["-u", "C:name", "C:", "c:a/../b"]),
        ("drive-relative-absolute", ["-au", "C:name"]),
        (
          "wide-argument-length",
          [
            "-u",
            "abc" + "😀".repeat(127) + "x",
            "abc" + "😀".repeat(127) + "xy",
            "//server/share/" + "界".repeat(250),
            "\\\\server\\share\\" + "界".repeat(250),
            "\\\\?\\GLOBALROOT\\Device\\Null",
            "\\\\?\\C:name",
          ],
        ),
        ("wide-list-length", ["-pu", "abc" + "😀".repeat(127) + "xy;C:/end"]),
        (
          "network-fallback",
          [
            "-u", "\\\\server", "\\\\.\\COM1", "//server/missing/../share", "\\\\?\\UNC\\server\\share",
            "\\??\\UNC\\server\\share",
          ],
        ),
        (
          "network-fallback-list",
          ["-pu", "\\\\?\\UNC\\server\\other;;//server;\\\\.\\COM1"],
        ),
        (
          "normalized-mount-tail",
          [
            "-u",
            root + "/bin/.",
            root + "/bin/nested/.",
            root + "/bin/nested/child/..",
            root + "/",
          ],
        ),
        ("cwd", ["-am", "./nonexistent"]),
        (
          "null-and-pseudo-handles",
          [
            "--close", " +0x00rest", "-c-1", "-cfffffffffffffffe", "-u", "C:/test",
          ],
        ),
        ("file", ["-m", "-f", input_path]),
        (
          "local-leading-slashes",
          ["-m", "///usr/bin/sh", "////usr/bin/../bin/sh.exe"],
        ),
        ("local-leading-slashes-input", ["-m", "-f", "//" + input_path]),
        ("symbol-windows", ["-wC42", "\u{f020}\u{f05c}\u{f0ff}"]),
        ("symbol-mixed", ["-mC42", "\u{f041}\u{f05c}\u{f042}"]),
        ("best-fit-drive-prefix", ["-wC1252", "＼＼？＼Ｃ：＼ｘ"]),
        (
          "best-fit-unc-prefix",
          ["-mC1252", "＼＼？＼ＵＮＣ＼ｓ＼ｘ"],
        ),
        ("gb18030", ["-w", "-C54936", "/cygdrive/c/中€𐀀"]),
        ("jis-20932", ["-wC20932", "/cygdrive/c/日ｶ丂髙😀"]),
        ("jis-20932-mixed", ["-mC20932", "/cygdrive/c/伙"]),
        ("gb2312-20936", ["-wC20936", "/cygdrive/c/中∥"]),
        ("wansung-20949", ["-mC20949", "/cygdrive/c/한글₩힣"]),
        ("logical-hebrew", ["-wC38598", "/cygdrive/c/אב·é😀"]),
        ("euc-korean", ["-mC51949", "/cygdrive/c/한글₩힣\u0081😀"]),
        ("iso2022-korean", ["-wC50225", "/cygdrive/c/한글 한/힣₩😀"]),
        ("iso2022-jp-wide-kana", ["-wC50220", "/cygdrive/c/ｶﾞ髙①😀"]),
        ("iso2022-jp-escape-kana", ["-wC50221", "/cygdrive/c/日ｶ本"]),
        ("iso2022-jp-shift-kana", ["-mC50222", "/cygdrive/c/日ｶ本"]),
        ("iso2022-cn-simplified", ["-wC50227", "/cygdrive/c/中文~文"]),
        ("iso2022-cn-traditional", ["-mC50229", "/cygdrive/c/中万中"]),
        ("hz-byte-zero", ["-wC52936", "/cygdrive/c/A\u{80}B"]),
        ("hz-gb2312", ["-mC52936", "/cygdrive/c/中文~文/丂€😀"]),
        ("iscii-pages", ["-of", input_path + ".iscii"]),
        ("ansi-best-fit", ["-wC1252", "/cygdrive/c/a\u{202f}b\u{2012}c"]),
        ("oem-best-fit", ["-wC437", "/cygdrive/c/a\u{2007}b"]),
        (
          "sjis-combining-kana",
          ["-wC932", "/cygdrive/c/か\u{3099}は\u{309a}"],
        ),
        ("utf7", ["-wC65000", "/cygdrive/c/é+中/😀"]),
        ("utf7-mixed", ["-mC65000", "/cygdrive/c/日本"]),
        ("utf7-list", ["-wpC65000", "/cygdrive/c/é:/cygdrive/d/中"]),
        ("utf7-root-local", ["-wrC65000", "/cygdrive/c/é"]),
        ("ebcdic-root-local", ["-wrC37", "/cygdrive/c/A"]),
        ("codepage-zero", ["-wC1252", "-C0", "/cygdrive/c/é中"]),
        (
          "gb18030-revision",
          ["-w", "-C54936", "/cygdrive/c/\u{1e3f}\u{e7c7}\u{fe10}\u{e78d}"],
        ),
        ("gb18030-mixed", ["-m", "-C54936", "/cygdrive/c/乗"]),
        ("sjis-mixed", ["-m", "-C932", "/cygdrive/c/ソ"]),
        ("ebcdic-mixed", ["-m", "-C37", "/cygdrive/c/A"]),
      ] {
      let reference = probe(
        output,
        "installed-" + name + "-oracle",
        cygpath,
        args,
        cwd,
        environment,
      )
      let project = probe(
        output,
        "installed-" + name + "-wasm",
        moonrun,
        [wasm, "--", ..args],
        cwd,
        installed,
      )
      compare(
        reference.status == "completed" &&
        reference.exit_code == Some(0) &&
        reference.stdout_length > 0 &&
        project.status == "completed" &&
        project.exit_code == reference.exit_code &&
        project.stdout_sha256 == reference.stdout_sha256 &&
        project.stderr_sha256 == reference.stderr_sha256,
        "installed context differs from cygpath: " + name,
      )
    }
  }
  let probe_environment = environment.copy()
  probe_environment["CYGPATH_CI_CWD"] = cwd
  let startup = probe(
    output,
    "powershell-startup",
    powershell,
    [
      "-NoLogo", "-NoProfile", "-NonInteractive", "-Command", "[Console]::Error.WriteLine('pwsh: startup'); [Console]::Out.Write('cygpath-pwsh-ready')",
    ],
    cwd,
    probe_environment,
  )
  require(
    successful_text(output, startup) == "cygpath-pwsh-ready",
    "PowerShell startup probe returned unexpected output",
  )
  let windows_query =
    #|[Console]::Error.WriteLine('host: startup')
    #|$ErrorActionPreference = 'Stop'
    #|[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false)
    #|[Console]::Error.WriteLine('host: item')
    #|$p = Get-Item -LiteralPath $env:CYGPATH_CI_CWD
    #|[Console]::Error.WriteLine('host: drive')
    #|$v = [IO.DriveInfo]::new($p.PSDrive.Root)
    #|[Console]::Error.WriteLine('host: registry')
    #|$r = Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\FileSystem'
    #|[Console]::Error.WriteLine('host: ACL')
    #|$sddl = (Get-Acl -LiteralPath $p.FullName).Sddl
    #|[Console]::Error.WriteLine('host: emit')
    #|[pscustomobject]@{os_version=[Environment]::OSVersion.VersionString; architecture=[Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString(); filesystem=$v.DriveFormat; test_volume=($v.Name + '; label=' + $v.VolumeLabel); input_code_page=[Console]::InputEncoding.CodePage.ToString(); output_code_page=[Console]::OutputEncoding.CodePage.ToString(); long_path_policy=('LongPathsEnabled=' + $r.LongPathsEnabled); short_name_policy=('NtfsDisable8dot3NameCreation=' + $r.NtfsDisable8dot3NameCreation); existence_permissions=($p.FullName + '; attributes=' + $p.Attributes + '; SDDL=' + $sddl); symlinks_junctions=('cwd LinkType=' + $p.LinkType + '; Target=' + $p.Target + '; Attributes=' + $p.Attributes)} | ConvertTo-Json -Compress
  let host_probe = probe(
    output,
    "windows-host",
    powershell,
    ["-NoLogo", "-NoProfile", "-NonInteractive", "-Command", windows_query],
    cwd,
    probe_environment,
  )
  let host = @json.parse(successful_text(output, host_probe))
  let version = probe(
    output,
    "upstream-version",
    cygpath,
    ["--version"],
    cwd,
    environment,
  )
  ignore(successful_text(output, version))
  // Official runtime startup must deliver the recorded argv literally. Its
  // native-parent wildcard expansion is unrelated to path conversion.
  let argv_echo = bin + "/printf.exe"
  require(
    @fs.exists(argv_echo),
    "official installation lacks coreutils printf.exe for literal argv transport evidence",
  )
  let argv_echo_artifact = artifact(argv_echo)
  let transport : Array[Json] = []
  for
    (id, payload) in [
      ("extended-drive", "\\\\?\\C:\\work\\file"),
      ("extended-unc", "\\\\?\\UNC\\server\\share\\file"),
      ("literal-wildcards", "a?b*c[0]"),
    ] {
    let check = probe(
      output,
      "argv-transport-" + id,
      argv_echo,
      ["%s", payload],
      cwd,
      environment,
    )
    require(
      check.status == "completed" && check.exit_code == Some(0),
      "official runtime argv transport probe failed",
    )
    let expected = @utf8.encode(payload)
    require(
      @fs.read_file(output + "/" + check.stdout_path).binary() == expected &&
      check.stderr_length == 0,
      "official runtime startup changed literal argv despite noglob",
    )
    transport.push({
      "id": id,
      "payload": payload,
      "expected_stdout_sha256": digest(expected),
      "observation": @json.to_json(check),
    })
  }
  save_json(output + "/argv-transport.json", {
    "schema_version": 1,
    "verified": true,
    "argv_echo_program": argv_echo_artifact,
    "argv_echo_origin": "official coreutils printf.exe from the same selected installation as cygpath and its runtime",
    "argv_echo_protocol": "direct process argv [%s, payload]; exact single-payload bytes, no shell code or delimiter",
    "runtime_environment": { "CYGWIN": "noglob", "MSYS": "noglob" },
    "source_urls": [
      "https://github.com/cygwin/cygwin/blob/b11613e477c006b2ce0332463ed07f1118260e79/winsup/cygwin/environ.cc",
      "https://github.com/msys2/msys2-runtime/blob/c770e1b9fa537fff9287c1fd40ebc84ac498fcb6/winsup/cygwin/environ.cc",
    ],
    "probes": @json.to_json(transport),
  })
  let runtime_version = successful_text(
    output,
    probe(output, "runtime-uname", bin + "/uname.exe", ["-a"], cwd, environment),
  )
  let package_program = bin +
    (if profile == "cygwin" { "/cygcheck.exe" } else { "/pacman.exe" })
  let package_args = if profile == "cygwin" {
    ["-c", "cygwin"]
  } else {
    ["-Qi", "msys2-runtime"]
  }
  let package_identity = successful_text(
    output,
    probe(
      output, "runtime-package", package_program, package_args, cwd, environment,
    ),
  )
  let prepared : Array[Json] = [{ "path": cwd, "kind": "working-directory" }]
  let mut mount_holder : Int32? = None
  let mut mount_holder_program : Json? = None
  if variant == "custom" {
    // Cygwin/MSYS user mounts are process-session state. Keep one official
    // runtime process alive while every collection/replay process observes it.
    let holder = bin + "/sleep.exe"
    require(
      @fs.exists(holder),
      "custom context requires official runtime sleep.exe to retain temporary mounts",
    )
    let holder_pid = @process.spawn_orphan(
      holder,
      ["1800"],
      extra_env=environment,
      inherit_env=false,
      cwd~,
      no_console_window=true,
    )
    require(holder_pid > 0, "custom mount session holder did not start")
    mount_holder = Some(holder_pid)
    mount_holder_program = Some(artifact(holder))
    save_json(output + "/custom-mount-session.json", {
      "schema_version": 1,
      "status": "started",
      "pid": holder_pid,
      "program": mount_holder_program.unwrap(),
      "lifetime_seconds": 1800,
      "reason": "temporary Cygwin/MSYS mounts disappear when the last runtime process exits",
      "source": "https://cygwin.com/cygwin-ug-net/mount.html",
    })
    for
      directory in [
        cwd + "/custom-base/nested",
        cwd + "/custom-nested",
        cwd + "/custom-shared/deep",
        cwd + "/custom-Fold",
        root + "/p3-mount/nested",
        root + "/p3-alias-first",
        root + "/p3-alias-second",
        root + "/p3-alias-deep",
        root + "/P3Fold",
      ] {
      @fs.mkdir(directory, recursive=true, allow_exist=true)
      require(
        @fs.kind(directory) is Directory,
        "custom mount preparation failed",
      )
      prepared.push({
        "path": path_text(@fs.realpath(directory)),
        "kind": "mount-directory",
      })
    }
    save_json(output + "/directory-preparation.json", {
      "schema_version": 1,
      "context_variant": variant,
      "directories": @json.to_json(prepared),
    })
    for
      (name, argv) in [
        ("set-custom-drive-prefix", ["-c", "/p3-drives"]),
        ("set-custom-base-mount", ["-f", cwd + "/custom-base", "/p3-mount"]),
        (
          "set-custom-nested-mount",
          ["-f", cwd + "/custom-nested", "/p3-mount/nested"],
        ),
        (
          "set-custom-first-alias",
          ["-f", cwd + "/custom-shared", "/p3-alias-first"],
        ),
        (
          "set-custom-second-alias",
          ["-f", cwd + "/custom-shared", "/p3-alias-second"],
        ),
        (
          "set-custom-deeper-alias",
          ["-f", cwd + "/custom-shared/deep", "/p3-alias-deep"],
        ),
        (
          "set-custom-fold-mount",
          ["-f", "-o", "posix=0", cwd + "/custom-Fold", "/P3Fold"],
        ),
      ] {
      ignore(
        successful_text(
          output,
          probe(output, name, bin + "/mount.exe", argv, cwd, environment),
        ),
      )
    }
  } else {
    save_json(output + "/directory-preparation.json", {
      "schema_version": 1,
      "context_variant": variant,
      "directories": @json.to_json(prepared),
    })
  }
  let mount_table = successful_text(
    output,
    probe(output, "mount-table", bin + "/mount.exe", [], cwd, environment),
  )
  let locale = successful_text(
    output,
    probe(output, "locale", bin + "/locale.exe", [], cwd, environment),
  )
  let official_root = path_text(
    successful_text(
      output,
      probe(output, "root-mapping", cygpath, ["-w", "/"], cwd, environment),
    ),
  )
  let usr_bin = path_text(
    successful_text(
      output,
      probe(
        output,
        "usr-bin-mapping",
        cygpath,
        ["-w", "/usr/bin"],
        cwd,
        environment,
      ),
    ),
  )
  let prefix = drive_prefix(
    successful_text(
      output,
      probe(output, "drive-prefix", cygpath, ["-u", "C:\\"], cwd, environment),
    ),
  )
  save_json(output + "/path-mapping-probes.json", {
    "root": official_root,
    "usr_bin": usr_bin,
    "context_mount_source": "Only declarations from the raw mount table are supplied to the project; queried path mappings do not create extra mounts.",
  })
  let measured_context = explicit_mount_args(wasm, profile, prefix, mount_table)
  for
    (label, args, code) in [
      ("folder-system-x86", ["-F", "41"], 0),
      ("folder-system-x86-proc", ["-UF0x29"], 0),
      ("folder-no-alias", ["-F0x1025"], 0),
      ("folder-expanded", ["-F0x2024"], 0),
      ("folder-no-alias-expanded", ["-F0x3025"], 0),
      ("drive-link-directory", ["-m", "/proc/cygdrive"], 0),
      ("absolute-root-directory", ["-aw", "/"], 0),
      ("drive-relative-list", ["-pu", "C:\\one;D:relative"], 0),
      ("drive-link-directory-slash", ["-aw", "/proc/cygdrive/"], 0),
      ("drive-link-parent", ["-m", "/proc/cygdrive/../p3-alias-neighbor"], 0),
      ("drive-link-drive", ["-w", "/proc/cygdrive/c/p3-alias-leaf"], 0),
      (
        "drive-link-non-drive",
        ["-w", "/proc/cygdrive/p3-absent"],
        if prefix == "/" {
          0
        } else {
          1
        },
      ),
    ] {
    let official = probe(
      output,
      label + "-oracle",
      cygpath,
      args,
      cwd,
      environment,
    )
    let project = probe(
      output,
      label + "-wasm",
      moonrun,
      measured_context + args,
      cwd,
      environment,
    )
    compare(
      official.status == "completed" &&
      official.exit_code == Some(code) &&
      project.status == "completed" &&
      project.exit_code == official.exit_code &&
      project.stdout_sha256 == official.stdout_sha256 &&
      project.stderr_sha256 == official.stderr_sha256,
      "conversion with measured mounts differs: " + label,
    )
  }
  if variant == "custom" {
    require(
      prefix == "/p3-drives",
      "official runtime did not retain the configured custom drive prefix",
    )
    let mounted = mounted_context(mount_table, prefix)
    let mapping_observations : Array[Json] = []
    for
      (posix, windows) in [
        ("/p3-mount", cwd + "/custom-base"),
        ("/p3-mount/nested", cwd + "/custom-nested"),
        ("/p3-alias-first", cwd + "/custom-shared"),
        ("/p3-alias-second", cwd + "/custom-shared"),
        ("/p3-alias-deep", cwd + "/custom-shared/deep"),
        ("/P3Fold", cwd + "/custom-Fold"),
      ] {
      require(
        mounted.any(mount => {
          text_field(mount, "posix") == posix &&
          text_field(mount, "windows") == windows
        }),
        "official mount table does not match configured fixture mapping: " +
        posix,
      )
      let measured = path_text(
        successful_text(
          output,
          probe(
            output,
            "custom-mapping-" + posix.replace_all(old="/", new="-"),
            cygpath,
            ["-w", posix],
            cwd,
            environment,
          ),
        ),
      )
      let direct_target_match = measured.trim_end(chars="/").to_owned() ==
        windows
      mapping_observations.push({
        "posix": posix,
        "declared_windows_target": windows,
        "observed_windows_path": measured,
        "direct_target_match": direct_target_match,
        "probe": "observations/custom-mapping-" +
        posix.replace_all(old="/", new="-") +
        ".json",
      })
      // MSYS2 searches its separately sorted mount list; the existence of a
      // nested declaration does not prove that declaration wins selection.
      // Preserve the original declarations for product context and let the
      // ordinary collect/replay cases enforce exact official/project equality.
      if profile == "cygwin" {
        require(
          direct_target_match, "independent Cygwin custom mount mapping probe differs",
        )
      }
    }
    require(
      mounted.any(mount => {
        text_field(mount, "posix") == "/P3Fold" &&
        text_field(mount, "case_policy") == "windows-insensitive"
      }),
      "official mount did not report requested posix=0 policy",
    )
    save_json(output + "/custom-mapping-observations.json", {
      "schema_version": 1,
      "profile": profile,
      "mount_declarations_verified": true,
      "observations": @json.to_json(mapping_observations),
      "selection_rule_source": if profile == "msys2" {
        "https://github.com/msys2/msys2-runtime/blob/c770e1b9fa537fff9287c1fd40ebc84ac498fcb6/winsup/cygwin/mount.cc#L1420-L1500"
      } else {
        "https://github.com/cygwin/cygwin/blob/b11613e477c006b2ce0332463ed07f1118260e79/winsup/cygwin/mount.cc#L1330-L1405"
      },
      "acceptance": "Mount declarations are checked against the configured targets. These probes retain the official selection result; they do not replace declarations with observations or accept any official/project difference. All supported custom fixtures must match stdout, stderr, and exit status exactly in Wasm collection and replay.",
    })
  }
  let windows_cwd = path_text(
    successful_text(
      output,
      probe(output, "windows-cwd", cygpath, ["-aw", "."], cwd, environment),
    ),
  )
  let posix_cwd = successful_text(
    output,
    probe(output, "posix-cwd", cygpath, ["-au", "."], cwd, environment),
  )
  let drive_cwd = path_text(
    successful_text(
      output,
      probe(
        output,
        "drive-c-cwd",
        powershell,
        [
          "-NoProfile", "-NonInteractive", "-Command", "[Console]::WriteLine([IO.Path]::GetFullPath('C:.'))",
        ],
        cwd,
        environment,
      ),
    ),
  )
  require(
    drive_cwd.has_prefix("C:/") || drive_cwd.has_prefix("c:/"),
    "native C-drive cwd probe did not return a drive-absolute Windows path",
  )
  let git = locate_tool("git.exe")
  let git_sha = successful_text(
    output,
    probe(
      output,
      "project-git-sha",
      git,
      ["rev-parse", "HEAD"],
      repository,
      environment,
    ),
  )
  let git_dirty = successful_text(
    output,
    probe(
      output,
      "project-git-status",
      git,
      ["status", "--porcelain", "--untracked-files=no"],
      repository,
      environment,
    ),
  )
  let moon_version = successful_text(
    output,
    probe(
      output,
      "moon-version",
      moon,
      ["version", "--all"],
      repository,
      environment,
    ),
  )
  let source_revision = options
    .get("--source-revision")
    .unwrap_or(
      "measured distribution package release identity (source Git commit not independently attested):\n" +
      package_identity,
    )
  let module_text = @fs.read_file(repository + "/moon.mod").text()
  let mut module_version = ""
  for line in module_text.split("\n") {
    let line = trimmed(line.to_owned())
    if line.has_prefix("version = ") {
      module_version = trimmed(line[10:].to_owned()).trim(chars="\"").to_owned()
    }
  }
  require(module_version != "", "module version could not be read")
  let upstream : Json = {
    "executable": artifact(cygpath),
    "runtime_library": artifact(runtime),
    "source_url": if profile == "cygwin" {
      "https://github.com/cygwin/cygwin"
    } else {
      "https://github.com/msys2/msys2-runtime"
    },
    "source_revision": source_revision,
    "distribution_version": package_identity,
    "runtime_version": runtime_version,
    "version_stdout_sha256": version.stdout_sha256,
    "version_stderr_sha256": version.stderr_sha256,
    "version_exit_code": 0,
  }
  let manifest_base : Json = {
    "schema_version": 1,
    "profile": profile,
    "upstream": upstream,
    "host": {
      "os": "windows",
      "os_version": text_field(host, "os_version"),
      "architecture": text_field(host, "architecture"),
      "filesystem": text_field(host, "filesystem"),
      "installation_root": official_root,
      "launch_method": "direct-process-argv",
      "current_drive": "C",
      "drive_cwds": { "C": drive_cwd },
      "mount_table": mount_table,
      "cygdrive_prefix": prefix,
      "existence_permissions": text_field(host, "existence_permissions"),
      "locale": locale,
      "input_code_page": text_field(host, "input_code_page"),
      "output_code_page": text_field(host, "output_code_page"),
      "io_mode": "redirected-binary",
      "long_path_policy": text_field(host, "long_path_policy"),
      "short_name_policy": text_field(host, "short_name_policy"),
      "test_volume": text_field(host, "test_volume"),
      "actual_short_names": "not exercised by read-only fixtures",
      "symlinks_junctions": text_field(host, "symlinks_junctions"),
    },
    "cwd": cwd,
    "environment": @json.to_json(environment),
    "cleared_environment": ["MSYSTEM"],
    "context": {
      "profile": profile,
      "drive_prefix": prefix,
      "mounts": @json.to_json(mounted_context(mount_table, prefix)),
      "posix_cwd": posix_cwd,
      "windows_cwd": windows_cwd,
      "drive_cwds": { "C": drive_cwd },
    },
    "context_mapping_evidence": "Sibling observations retain raw mount/locale/cygpath cwd and mapping probes with their exact argv, bytes, status, and hashes. Per-drive C cwd is measured by the native Windows .NET Path.GetFullPath API on C:.; it is not inferred by converting the ambiguous C: operand with cygpath. Mounts are transcribed in observed order; auto cygdrive and virtual /dev,/proc entries are excluded. Mount case policy is transcribed from posix=0 and supplied explicitly. Root and /usr/bin mappings are independently queried. Custom declarations remain unchanged when MSYS2 selects another matching mount; custom-mapping-observations.json retains that distinction and strict fixture comparisons remain mandatory. Host facts come from the retained PowerShell observation; source Git provenance is separately qualified.",
    "capabilities": [
      "portable-paths", "utf8", "stdin", "root-mount", "usr-bin-mapping", "posix-cwd",
      "windows-cwd", "drive-cwd-c",
    ],
    "deadline_ms": 10000,
  }
  let backend = "wasm"
  let manifest = output + "/manifest-wasm.json"
  {
    let project : Json = {
      "artifact": artifact(wasm),
      "launcher": artifact(moonrun),
      "backend": backend,
      "git_sha": git_sha,
      "dirty": git_dirty != "",
      "module_version": module_version,
      "moon_version": moon_version,
      "build_mode": "release",
    }
    guard manifest_base is Object(fields) else {
      fail("manifest base must be object")
    }
    let fields = fields.copy()
    fields["project"] = project
    save_json(manifest, Json::object(fields))
  }
  let signatures : Map[String, String] = Map([])
  let results : Array[GateCase] = []
  let infrastructure : Array[Json] = []
  let mut accepted = true
  let suites = [
    ("profile", repository + "/testdata/oracle/fixtures." + profile + ".json"),
    ("matrix", repository + "/testdata/oracle/fixtures.readonly-matrix.json"),
    ("p3", repository + "/testdata/oracle/fixtures.p3.json"),
  ]
  if variant == "custom" {
    suites.push(
      ("custom", repository + "/testdata/oracle/fixtures.custom.json"),
    )
  }
  let fixture_preparations : Array[Json] = []
  for (suite, path) in suites {
    let fixture = @json.parse(@fs.read_file(path).text())
    let cases : Array[Json] = @json.from_json(field(fixture, "cases"))
    for item in cases {
      if optional_field(item, "file_hex") is Some(hex) {
        fixture_preparations.push({
          "suite": suite,
          "case_id": text_field(item, "case_id"),
          "path": cwd +
          "/.cygpath-oracle-fixtures/" +
          text_field(item, "case_id") +
          ".bin",
          "file_hex": hex,
          "policy": "create-new or verify identical before and after each process; replay verifies identical bytes",
        })
      }
    }
  }
  save_json(output + "/fixture-preparation-plan.json", {
    "schema_version": 1,
    "context_variant": variant,
    "files": @json.to_json(fixture_preparations),
  })
  for (suite, fixtures) in suites {
    let collection = output + "/" + suite + "-" + backend + "-collect"
    let replay = output + "/" + suite + "-" + backend + "-replay"
    for
      (mode, source, directory) in [
        ("collect", fixtures, collection),
        ("replay", collection, replay),
      ] {
      let name = suite + "-" + backend + "-" + mode
      let execution = probe(
        output,
        name,
        moon,
        [
          "run",
          "--deny-warn",
          repository + "/scripts/oracle.mbtx",
          mode,
          manifest,
          source,
          directory,
        ],
        repository,
        environment,
        deadline=600000,
      )
      // oracle.mbtx exits 1 for raw comparison failures. The independently
      // checked run file distinguishes those from infrastructure failures.
      try {
        require(
          execution.status == "completed",
          "collector process did not complete: " + name,
        )
        if !validate_run(
            directory,
            profile,
            suite,
            mode,
            backend,
            manifest,
            fixtures,
            execution.exit_code,
            signatures,
            results,
          ) {
          accepted = false
        }
      } catch {
        error => {
          accepted = false
          infrastructure.push({
            "run": name,
            "diagnostic": error.to_string(),
            "execution": @json.to_json(execution),
          })
        }
      }
      save_json(output + "/summary.json", {
        "schema_version": 1,
        "profile": profile,
        "context_variant": variant,
        "complete": false,
        "accepted": false,
        "raw_results_preserved": true,
        "infrastructure_errors": @json.to_json(infrastructure),
        "cases": @json.to_json(results),
      })
    }
  }
  if variant == "custom" {
    // Add this mount after recording the frozen matrix. Another declaration
    // can change the order of equal aliases in the MSYS2 mount table.
    let posix = "/p3-case-ÄΣ"
    let native = cwd + "/case-ÄΣ"
    @fs.mkdir(root + posix)
    defer @fs.rmdir(root + posix)
    @fs.mkdir(native)
    defer @fs.rmdir(native)
    ignore(
      successful_text(
        output,
        probe(
          output,
          "set-unicode-mount",
          bin + "/mount.exe",
          ["-f", "-o", "posix=0", native, posix],
          cwd,
          environment,
        ),
      ),
    )
    defer @async.protect_from_cancel(() => {
      ignore(
        successful_text(
          output,
          probe(
            output,
            "unset-unicode-mount",
            bin + "/umount.exe",
            [posix],
            cwd,
            environment,
          ),
        ),
      )
    })
    let raw = successful_text(
      output,
      probe(
        output,
        "unicode-mount-table",
        bin + "/mount.exe",
        [],
        cwd,
        environment,
      ),
    )
    let explicit = explicit_mount_args(wasm, profile, prefix, raw)
    for
      (label, args) in [
        ("forward", ["-m", "/p3-case-äσ/Keep"]),
        ("reverse", ["-u", cwd + "/case-äσ/Keep"]),
        ("final-sigma", ["-m", "/p3-case-äς/Keep"]),
        ("component-boundary", ["-m", "/p3-case-äσx/Keep"]),
      ] {
      let official = probe(
        output,
        "mount-case-" + label + "-oracle",
        cygpath,
        args,
        cwd,
        environment,
      )
      let project = probe(
        output,
        "mount-case-" + label + "-wasm",
        moonrun,
        [..explicit, ..args],
        cwd,
        environment,
      )
      require(
        official.status == "completed" &&
        official.exit_code == Some(0) &&
        official.stdout_length > 0 &&
        project.status == "completed" &&
        project.exit_code == official.exit_code &&
        project.stdout_sha256 == official.stdout_sha256 &&
        project.stderr_sha256 == official.stderr_sha256,
        "Unicode mount case differs: " + label,
      )
      if label == "forward" {
        require(
          official.stdout_sha256 == digest(@utf8.encode(native + "/Keep\n")),
          "positive control did not select the Unicode mount",
        )
      }
    }
  }
  if mount_holder is Some(holder_pid) {
    let stopped = probe(
      output,
      "stop-custom-mount-session",
      powershell,
      [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "Stop-Process -Id " +
        holder_pid.to_string() +
        " -Force -ErrorAction SilentlyContinue",
      ],
      cwd,
      probe_environment,
    )
    require(
      stopped.status == "completed" && stopped.exit_code == Some(0),
      "custom mount session holder did not stop",
    )
    save_json(output + "/custom-mount-session-stop.json", {
      "schema_version": 1,
      "status": "stopped",
      "pid": holder_pid,
      "observation": @json.to_json(stopped),
    })
    save_json(output + "/custom-mount-session.json", {
      "schema_version": 1,
      "status": "stopped",
      "pid": holder_pid,
      "program": mount_holder_program.unwrap(),
      "lifetime_seconds": 1800,
      "reason": "temporary Cygwin/MSYS mounts disappear when the last runtime process exits",
      "source": "https://cygwin.com/cygwin-ug-net/mount.html",
      "stop_observation": "custom-mount-session-stop.json",
    })
  }
  let mut coverage_verified = false
  try {
    coverage_verified = audit_scope(
      repository, output, profile, variant, results,
    )
  } catch {
    error =>
      infrastructure.push({
        "run": "coverage-audit",
        "diagnostic": error.to_string(),
      })
  }
  let fault = probe(
    output,
    "fault-drills",
    moon,
    [
      "run",
      "--deny-warn",
      repository + "/scripts/oracle.mbtx",
      "fault-drill",
      manifest,
      output + "/profile-wasm-collect",
      output + "/fault-drills",
      powershell,
    ],
    repository,
    environment,
    deadline=120000,
  )
  let mut fault_verified = false
  try {
    require(
      fault.status == "completed" && fault.exit_code == Some(0),
      "real Windows fault drills did not complete successfully",
    )
    let fault_summary = @json.parse(
      @fs.read_file(output + "/fault-drills/summary.json").text(),
    )
    require(
      text_field(fault_summary, "validation_kind") ==
      "real-windows-fault-drills" &&
      bool_field(fault_summary, "complete") &&
      int_field(fault_summary, "passed") == 5 &&
      int_field(fault_summary, "failed") == 0,
      "incomplete fault drill result",
    )
    fault_verified = true
  } catch {
    error =>
      infrastructure.push({
        "run": "fault-drills",
        "diagnostic": error.to_string(),
        "execution": @json.to_json(fault),
      })
  }
  accepted = accepted &&
    comparison_failures.is_empty() &&
    coverage_verified &&
    fault_verified &&
    infrastructure.is_empty()
  save_json(output + "/summary.json", {
    "schema_version": 1,
    "profile": profile,
    "context_variant": variant,
    "source_detection": "natural CLI auto-detection; source_type is descriptive fixture metadata only",
    "complete": infrastructure.is_empty(),
    "accepted": accepted,
    "raw_results_preserved": true,
    "comparisons": results.length(),
    "supported_exact_comparisons": results
    .filter(result => {
      result.validation_domain == "supported" && result.gate_status == "pass"
    })
    .length(),
    "input_domain_boundary_observations": results
    .filter(result => result.gate_status == "input-domain-boundary")
    .length(),
    "capability_boundary_observations": results
    .filter(result => result.gate_status == "capability-boundary")
    .length(),
    "additional_comparisons": extra_comparisons,
    "additional_comparison_failures": @json.to_json(comparison_failures),
    "coverage_verified": coverage_verified,
    "fault_drills_verified": fault_verified,
    "infrastructure_errors": @json.to_json(infrastructure),
    "cases": @json.to_json(results),
  })
  println("official oracle CI evidence: " + output)
  println(
    "profile=\{profile} comparisons=\{results.length()} accepted=\{accepted}",
  )
  require(
    accepted, "official comparisons require exact equality with zero infrastructure/backend failures",
  )
}

///|
fn self_test() -> Unit raise {
  assert_eq(drive_prefix("/cygdrive/c/"), "/cygdrive")
  assert_eq(drive_prefix("/c/"), "/")
  require(
    drive_mount("/cygdrive/c", "/cygdrive") && drive_mount("/c", "/"),
    "drive mount classification",
  )
  require(
    !drive_mount("/usr/bin", "/") &&
    !drive_mount("/cygdrive/c/work", "/cygdrive"),
    "ordinary mount misclassified",
  )
  let mounts = mounted_context(
    "C:/root on / type ntfs (binary)\nC: on /cygdrive/c type ntfs (binary)\nC:/root/bin on /usr/bin type ntfs (binary)",
    "/cygdrive",
  )
  assert_eq(mounts.length(), 2)
  assert_eq(text_field(mounts[1], "posix"), "/usr/bin")
  let folded = mounted_context(
    "C:/fold on /P3Fold type ntfs (binary,posix=0,user)", "/cygdrive",
  )
  assert_eq(text_field(folded[0], "case_policy"), "windows-insensitive")
  assert_eq(folded.length(), 1)
  let raw_msys = mounted_context(
    "C:/msys64 on / type ntfs (binary,noacl,auto)\nC:/msys64/usr/bin on /bin type ntfs (binary,noacl,auto)",
    "/",
  )
  assert_eq(raw_msys.length(), 2)
  require(
    !raw_msys.any(mount => text_field(mount, "posix") == "/usr/bin"),
    "a queried mapping must not invent a mount absent from the raw table",
  )
  let oracle : Json = {
    "stdout": { "sha256": digest(b"official"), "length": 8 },
    "stderr": { "sha256": digest(b""), "length": 0 },
    "exit_code": 0,
  }
  let project : Json = {
    "stdout": { "sha256": digest(b"portable"), "length": 8 },
    "stderr": { "sha256": digest(b""), "length": 0 },
    "exit_code": 2,
  }
  require(
    observation_signature(oracle) != observation_signature(project),
    "different output/exit observations must remain unequal",
  )
  println("CI oracle parser self-test passed; no Windows compatibility tested")
}

///|
async fn main {
  try {
    let args = @env.args()[1:]
    if args is ["self-test"] {
      self_test()
    } else {
      run(parse_options(args))
    }
  } catch {
    error => {
      @stdio.stderr.write("ci_oracle: " + error.to_string() + "\n") catch {
        _ => ()
      }
      @env.exit(1)
    }
  }
}
